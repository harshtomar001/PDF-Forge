<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.github.barteksc.pdfviewer.PDFView
        android:id="@+id/pdfView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/download_card_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_25dp"
        android:layout_marginStart="@dimen/margin_20dp"
        android:layout_marginEnd="@dimen/margin_20dp"
        app:strokeWidth="0dp"
        app:cardElevation="@dimen/margin_40dp"
        android:layout_gravity="bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/upl_pdf_cmp_pdf"
            android:gravity="center"
            android:padding="@dimen/margin_12dp">

            <ImageView
                android:layout_width="@dimen/margin_30dp"
                android:layout_height="@dimen/margin_30dp"
                android:layout_marginEnd="@dimen/margin_5dp"
                android:src="@drawable/download_icon_no_bg" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Download PDF"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/margin_20dp"
                android:textStyle="bold">

            </TextView>

        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>

    <include
        android:id="@+id/loading_overlay"
        layout="@layout/loading_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />


</FrameLayout>
