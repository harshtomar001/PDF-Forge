<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pdf_background">

    <!-- ============ TOP APP BAR ============ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/pdf_card_white"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/title_merge_pdf"
            android:textColor="@color/pdf_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============ SCROLLABLE CONTENT ============ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mergeResultScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- ===== SUCCESS HEADER ===== -->
            <ImageView
                android:id="@+id/successIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_success_check"
                android:contentDescription="@string/cd_success"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvSuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/title_pdf_merged"
                android:textColor="@color/pdf_success_green"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/successIcon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvSuccessSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/subtitle_merge_success"
                android:textColor="@color/pdf_text_secondary"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tvSuccessTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.82" />

            <!-- ===== PDF PREVIEW CARD ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pdfPreviewCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/pdf_card_white"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvSuccessSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp">

                    <ImageView
                        android:id="@+id/ivPdfPreview"
                        android:layout_width="64dp"
                        android:layout_height="76dp"
                        android:src="@drawable/ic_pdf_illustration"
                        android:contentDescription="@string/cd_pdf_preview"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tvPdfName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/placeholder_pdf_name"
                        android:textColor="@color/pdf_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/ivPdfPreview"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/ivPdfPreview" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toEndOf="@id/ivPdfPreview"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPdfName">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_doc_small"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvPdfPages"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/placeholder_pdf_pages"
                            android:textColor="@color/pdf_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/dot_separator"
                            android:textColor="@color/pdf_primary_red"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_size_small"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvPdfSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/placeholder_pdf_size"
                            android:textColor="@color/pdf_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ===== MERGE SUMMARY CARD ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mergeSummaryCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/pdf_card_white"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/pdfPreviewCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="@string/title_merge_summary"
                        android:textColor="@color/pdf_primary_red"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Row: Files Merged -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/folder"
                            android:contentDescription="@null"
                            app:tint="@color/pdf_primary_red" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/label_files_merged"
                            android:textColor="@color/pdf_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvFilesMerged"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_files_merged"
                            android:textColor="@color/pdf_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View style="@style/SummaryRowDivider" />

                    <!-- Row: Total Pages -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_doc_small"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/label_total_pages"
                            android:textColor="@color/pdf_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTotalPages"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_total_pages"
                            android:textColor="@color/pdf_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View style="@style/SummaryRowDivider" />

                    <!-- Row: Page Size -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_page_size"
                            android:contentDescription="@null" />

                        <TextView

                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/label_page_size"
                            android:textColor="@color/pdf_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvPageSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_page_size"
                            android:textColor="@color/pdf_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View style="@style/SummaryRowDivider" />

                    <!-- Row: Margins -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_margins"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/label_margins"
                            android:textColor="@color/pdf_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvMargins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_margins"
                            android:textColor="@color/pdf_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ===== PRIMARY BUTTON: OPEN PDF ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenPdf"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/pdf_primary_red"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_open_pdf"
                android:textAllCaps="false"
                android:textColor="@color/pdf_card_white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_open_pdf"
                app:iconGravity="textStart"
                app:iconTint="@color/pdf_card_white"
                app:layout_constraintTop_toBottomOf="@id/mergeSummaryCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ===== SECONDARY BUTTONS: SHARE / SAVE ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_share"
                android:textAllCaps="false"
                android:textColor="@color/pdf_primary_red"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconTint="@color/pdf_primary_red"
                app:strokeColor="@color/pdf_primary_red"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/btnOpenPdf"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnSave"
                app:layout_constraintHorizontal_chainStyle="spread" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"

                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/download"
                android:textAllCaps="false"
                android:textColor="@color/pdf_primary_red"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/download_icon"
                app:iconSize="@dimen/margin_24dp"
                app:iconGravity="textStart"
                app:iconTint="@color/pdf_primary_red"
                app:strokeColor="@color/pdf_primary_red"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="@id/btnShare"
                app:layout_constraintStart_toEndOf="@id/btnShare"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ===== BOTTOM ACTION: MERGE ANOTHER PDF ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMergeAnother"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/action_merge_another"
                android:textAllCaps="false"
                android:textColor="@color/pdf_primary_red"
                android:textSize="15sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconTint="@color/pdf_primary_red"
                app:layout_constraintTop_toBottomOf="@id/btnShare"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>


    <LinearLayout
        android:elevation="@dimen/margin_24dp"
        android:visibility="gone"
        android:id="@+id/loaderLayout"
        android:background="@color/loader_scrim_soft"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        android:gravity="center"
        >

        <ImageView
            android:id="@+id/loaderRing"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/loader_ring_animated"
            android:layout_marginTop="-40dp"
            />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Downloading File..."
            android:textSize="@dimen/margin_20dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="@dimen/margin_20dp"
            />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
