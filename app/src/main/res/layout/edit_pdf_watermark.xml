<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:elevation="@dimen/margin_50dp"
    android:paddingTop="@dimen/margin_15dp"
    android:layout_height="match_parent">


    <ImageView
        android:id="@+id/backArrow_watermark"
        android:layout_width="@dimen/margin_30dp"
        android:layout_height="@dimen/margin_30dp"
        app:srcCompat="@drawable/ic_back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/margin_8dp"
        app:layout_constraintTop_toTopOf="@id/watermark_title"
        app:layout_constraintBottom_toBottomOf="@id/watermark_title"
        app:tint="@color/darkGray" />

    <TextView
        android:id="@+id/watermark_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Watermark"
        android:textColor="@color/color_text_primary"
        android:textSize="20dp"
        android:textStyle="bold"
        android:layout_marginStart="@dimen/margin_15dp"
        app:layout_constraintStart_toEndOf="@id/backArrow_watermark"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="@dimen/margin_12dp"
        />

    <View
        android:id="@+id/titleBreak"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="0.4"
        android:layout_marginHorizontal="@dimen/margin_8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/watermark_title"
        android:background="@color/darkGray"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/titleBreak"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0"
        android:layout_marginBottom="@dimen/margin_12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_segment_container"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_text_watermark"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Text"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/margin_18dp"
                    android:textStyle="bold"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_segment_selected" />

                <TextView
                    android:id="@+id/btn_image_watermark"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Image"
                    android:textColor="@color/darkGray"
                    android:textStyle="bold" />

            </LinearLayout>

            <EditText
                android:id="@+id/edt_watermark_text"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_input_box_"
                android:hint="Enter watermark text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/color_text_primary"
                android:textColorHint="@color/color_text_tertiary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/upload_watermark_image"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="Select Image"
                android:background="@drawable/upl_img_bg"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textColor="@color/color_primary"
                app:iconTint="@color/color_primary"
                app:icon="@drawable/add_btn"
                app:iconGravity="textStart"
                app:iconSize="@dimen/margin_30dp"
                android:visibility="gone" />

            <include
                android:id="@+id/cardSelectedWatermarkImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/edit_pdf_img_card_watermark"
                android:layout_marginTop="@dimen/margin_12dp"
                android:visibility="gone"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="@dimen/margin_18dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Opacity (Visibility)"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/opacity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.3"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_opacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:trackColorActive="@color/color_primary"
                app:trackColorInactive="@color/color_primary_container"
                app:thumbColor="@color/color_primary"
                app:haloColor="@color/color_primary_container"
                app:tickVisible="false"
                android:valueFrom="0"
                android:valueTo="1"
                android:value=".4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="@dimen/margin_18dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/size_textview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginTop="14dp"
                    android:text="Size (px)"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24px"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold" />

            </LinearLayout>



            <com.google.android.material.slider.Slider
                android:id="@+id/slider_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:trackColorActive="@color/color_primary"
                app:trackColorInactive="@color/color_primary_container"
                app:thumbColor="@color/color_primary"
                app:haloColor="@color/color_primary_container"
                app:tickVisible="false"
                android:valueFrom="0"
                android:valueTo="64"
                android:stepSize="1"

                android:value="24" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="@dimen/margin_18dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginTop="14dp"
                    android:text="Rotation (°)"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rotation_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0°"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold" />

            </LinearLayout>



            <com.google.android.material.slider.Slider
                android:id="@+id/slider_rotation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                app:trackColorActive="@color/color_primary"
                app:trackColorInactive="@color/color_primary_container"
                app:thumbColor="@color/color_primary"
                app:haloColor="@color/color_primary_container"
                app:tickVisible="false"
                android:valueTo="360"
                android:value="0"
                android:stepSize="1"
                />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                >


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Position:  "
                android:maxLines="1"
                android:ellipsize="none"
                android:textSize="@dimen/margin_18dp"
                android:textColor="@color/color_text_primary"
                android:textStyle="normal" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:id="@+id/position_layout"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:boxStrokeWidth="0dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp"
                    app:endIconMode="custom"
                    app:endIconTint="@color/black"
                    android:layout_marginTop="5dp"
                    app:endIconDrawable="@drawable/chevron_down_icon_black"
                    android:layout_marginStart="@dimen/margin_30dp">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/dropdown_position"
                        android:layout_width="170dp"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="true"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:gravity="center_vertical|start"
                        android:paddingStart="8dp"
                        android:dropDownHeight="380dp"
                        android:paddingTop="@dimen/margin_12dp"
                        android:paddingEnd="28dp"
                        android:textColor="@color/color_text_primary"
                        android:text="Center" />



            </com.google.android.material.textfield.TextInputLayout>



            </LinearLayout>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <FrameLayout
                    android:id="@+id/preview_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white">
                    <ImageView
                        android:id="@+id/watermark_logo_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:layout_gravity="center"
                        android:alpha="0.3"
                        android:visibility="gone"/>
                    <TextView
                        android:id="@+id/preview_watermark_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Watermark"
                        android:alpha="0.3"
                        android:textSize="24sp"
                        android:layout_gravity="center"
                        android:textColor="@color/color_primary"/>

                </FrameLayout>

            </androidx.cardview.widget.CardView>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apply_watermark"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/color_primary"
                android:text="Apply Watermark"
                android:textColor="@color/color_on_primary"
                app:cornerRadius="@dimen/margin_12dp"
                android:textStyle="bold" />

        </LinearLayout>







    </ScrollView>




</androidx.constraintlayout.widget.ConstraintLayout>