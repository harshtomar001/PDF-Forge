<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/upl_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/upl_pdf_bg_ep"
    android:gravity="center_horizontal"
    android:layout_marginTop="@dimen/margin_20dp"
    android:layout_marginStart="@dimen/margin_20dp"
    android:layout_marginBottom="@dimen/margin_20dp"
    android:layout_marginEnd="@dimen/margin_20dp"
    android:padding="@dimen/margin_12dp"
    android:orientation="vertical"
    app:layout_constraintTop_toTopOf="parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <ImageView
        android:id="@+id/pdf_icon_cmp_ep"
        android:layout_width="@dimen/margin_50dp"
        android:layout_height="@dimen/margin_50dp"
        app:srcCompat="@drawable/pdf_icon_rounded__1_" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/upload_pdf"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"

        />

    <TextView
        android:id="@+id/textView_cmp_ep"
        android:layout_width="wrap_content"
        android:maxWidth="230dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAlignment="center"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="@dimen/margin_12dp"
        android:alpha="0.5"
        android:text="@string/extract_all_images_text" />

    <LinearLayout
        android:id="@+id/upload_pdf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_12dp"
        android:gravity="center"
        android:background="@drawable/upl_pdf_ep"
        android:paddingLeft="@dimen/margin_12dp"
        android:paddingRight="@dimen/margin_12dp"
        android:paddingTop="@dimen/margin_8dp"
        android:paddingBottom="@dimen/margin_8dp"
        android:orientation="horizontal">


        <ImageView
            android:id="@+id/imageView12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:srcCompat="@drawable/upload_sign" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/margin_5dp"
            android:textSize="@dimen/margin_18dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:text="Choose PDF" />


    </LinearLayout>


</LinearLayout>