<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        android:background="#80000000"
        android:visibility="gone"
        android:elevation="@dimen/margin_50dp"
        android:clickable="true"
        android:focusable="true"

        >

        <ProgressBar
            android:id="@+id/progressBar2"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"/>

        <TextView
            android:layout_marginTop="@dimen/margin_50dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/downloading"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:textSize="@dimen/margin_18dp"
            />
    </FrameLayout>

    <include
        android:id="@+id/title_out"
        layout="@layout/title_edit_img_out"
        app:layout_constraintTop_toTopOf="parent"
        />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewInformation"
        android:layout_width="match_parent"
        app:strokeWidth="0dp"
        app:cardElevation="@dimen/margin_12dp"
        app:cardBackgroundColor="@color/white"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_20dp"
        app:layout_constraintTop_toBottomOf="@+id/title_out"
        android:layout_marginTop="@dimen/margin_20dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_8dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_height="@dimen/margin_60dp"
                android:layout_width="@dimen/margin_60dp"
                android:src="@drawable/green_tick_with_shadow"
                />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_5dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/convertedSuccessfully"
                    android:textSize="@dimen/margin_12dp"
                    android:textStyle="bold"
                    android:textColor="#0f4021"
                    tools:ignore="SpUsage" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/readyDownload"
                    android:textSize="@dimen/margin_10dp" />

            </LinearLayout>


            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/margin_15dp"
                android:layout_marginBottom="@dimen/margin_12dp"
                android:layout_marginLeft="@dimen/margin_12dp"
                android:layout_marginRight="@dimen/margin_5dp"
                android:alpha="0.6"
                android:background="#c7c5c5" />


            <ImageView
                android:layout_height="@dimen/margin_40dp"
                android:layout_width="@dimen/margin_40dp"
                android:src="@drawable/blue_file_icon"
                android:layout_gravity="center"
                />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/margin_5dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/format"
                    android:textSize="@dimen/margin_12dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:alpha="0.7"
                    android:textColor="#0f4021"/>

                <TextView
                    android:id="@+id/format"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/png"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="@dimen/margin_10dp" />

            </LinearLayout>

        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/activity"
        android:layout_margin="@dimen/margin_20dp"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        app:strokeWidth="0dp"
        app:cardElevation="@dimen/margin_12dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/cardViewInformation"
        >


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/margin_12dp"
            android:paddingTop="@dimen/margin_12dp"
            android:paddingBottom="@dimen/margin_12dp"
            android:paddingRight="@dimen/margin_5dp"
            android:orientation="horizontal">


            <LinearLayout
                android:id="@+id/download_ALL"

                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/download_all_ei_bg"
                android:layout_weight="2"
                android:gravity="center"
                android:paddingTop="@dimen/margin_5dp"
                android:paddingBottom="@dimen/margin_5dp"
                android:layout_marginRight="@dimen/margin_12dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_height="@dimen/margin_30dp"
                    android:layout_width="@dimen/margin_30dp"
                    android:src="@drawable/download_icon_no_bg"
                    android:layout_gravity="center"
                    />

                <TextView
                    android:id="@+id/download_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/downloadAllSize"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/white"
                    android:textStyle="bold"

                    android:textSize="@dimen/margin_12dp"
                    />



            </LinearLayout>

            <LinearLayout
                android:id="@+id/share_All"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@drawable/share_del_ei_out_bg"
                android:layout_gravity="center"
                android:paddingTop="@dimen/margin_5dp"
                android:paddingBottom="@dimen/margin_5dp"
                android:layout_marginEnd="@dimen/margin_8dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_height="@dimen/margin_30dp"
                    android:layout_width="@dimen/margin_30dp"
                    android:src="@drawable/share_icon_blue"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shareAll"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#28264a"
                    android:textStyle="bold"
                    android:textSize="@dimen/margin_10dp" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/delete_all"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingRight="@dimen/margin_5dp"
                android:paddingTop="@dimen/margin_5dp"
                android:paddingBottom="@dimen/margin_5dp"
                android:background="@drawable/share_del_ei_out_bg"
                android:orientation="horizontal">


                <ImageView
                    android:layout_height="@dimen/margin_30dp"
                    android:layout_width="@dimen/margin_30dp"
                    android:src="@drawable/delete_icon_blue_outline"

                    />

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/deleteAll"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#28264a"
                    android:textStyle="bold"
                    android:textSize="@dimen/margin_10dp"
                    />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/total_cnvt_img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/converted_images_10"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/activity"
        app:layout_constraintBottom_toTopOf="@id/recycler_card"
        android:layout_marginTop="@dimen/margin_20dp"
        android:layout_marginLeft="@dimen/margin_20dp"
        android:layout_marginRight="@dimen/margin_20dp"

         />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/recycler_card"
        android:layout_margin="@dimen/margin_20dp"
        app:strokeWidth="0dp"
        android:layout_height="0dp"
        android:layout_width="match_parent"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/total_cnvt_img"
        app:layout_constraintBottom_toTopOf="@id/shield_div">


        <ImageView
            android:id="@+id/no_img_converted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:src="@drawable/no_converted_images"
            />


        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/outputRecyclerView" />



    </com.google.android.material.card.MaterialCardView>


    <LinearLayout
        android:id="@+id/shield_div"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_20dp"
        android:layout_marginRight="@dimen/margin_20dp"
        android:layout_marginTop="@dimen/margin_20dp"
        android:layout_marginBottom="@dimen/margin_8dp"
        android:padding="@dimen/margin_8dp"
        android:background="@drawable/encrypted_ei_bg"
        app:layout_constraintBottom_toTopOf="@+id/bottoms_buttons">


        <ImageView
            android:layout_width="50dp"
            android:layout_height="@dimen/margin_50dp"
            app:srcCompat="@drawable/shield_security_icon" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/margin_8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/safeFiles"
                android:textSize="@dimen/margin_15dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#473d82"/>

            <TextView

                android:maxLines="1"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/safeFileText"
                android:textSize="@dimen/margin_10dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="@dimen/margin_20dp"
        android:layout_marginRight="@dimen/margin_20dp"
        android:layout_marginTop="@dimen/margin_5dp"
        android:layout_marginBottom="@dimen/margin_12dp"
        android:id="@+id/bottoms_buttons"

        app:layout_constraintBottom_toBottomOf="parent">


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/back_to_prev"
            android:clickable="true"
            android:focusable="false"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_width="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/encrypted_ei_bg"
                android:paddingRight="@dimen/margin_5dp"
                android:paddingTop="@dimen/margin_8dp"
                android:paddingBottom="@dimen/margin_8dp"
                android:gravity="center"
                android:orientation="horizontal">


                <ImageView
                    android:layout_height="@dimen/margin_40dp"
                    android:layout_width="@dimen/margin_40dp"
                    android:src="@drawable/blue_back_arrow_no_bg"
                    android:layout_gravity="center"
                    />

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/convertMoreImages"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:textColor="#473d82"

                    />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/back_to_home"
            android:clickable="true"
            android:focusable="true"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/margin_8dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/white">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/download_all_ei_bg"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">


                <ImageView
                    android:layout_height="@dimen/margin_30dp"
                    android:layout_width="@dimen/margin_40dp"
                    android:src="@drawable/white_home_icon_filled"
                    android:layout_gravity="center"
                    />

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goToHome"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:layout_gravity="center"
                    android:textColor="@color/white"

                    />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>