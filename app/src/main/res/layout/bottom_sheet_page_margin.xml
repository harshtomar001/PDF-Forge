<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/pdf_studio_white"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_lg">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/pdf_studio_divider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/merge_page_margin_sheet_title"
        android:textColor="@color/pdf_studio_dark_navy"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- No Margin -->
    <LinearLayout
        android:id="@+id/rowMarginNone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="@drawable/bg_merge_page_size_selected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_sm">

        <RadioButton
            android:id="@+id/radioMarginNone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:clickable="false"
            android:buttonTint="@color/rgb_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page_margin_none_label"
                android:textColor="@color/pdf_studio_dark_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page_margin_none_desc"
                android:textColor="@color/pdf_studio_secondary_gray"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Small -->
    <LinearLayout
        android:id="@+id/rowMarginSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="@drawable/bg_merge_page_size_selected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_sm">

        <RadioButton
            android:id="@+id/radioMarginSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:buttonTint="@color/rgb_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page_margin_small_label"
                android:textColor="@color/pdf_studio_dark_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page_margin_small_desc"
                android:textColor="@color/pdf_studio_secondary_gray"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Medium -->
    <LinearLayout
        android:id="@+id/rowMarginMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="@drawable/bg_merge_page_size_selected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_sm">

        <RadioButton
            android:id="@+id/radioMarginMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:buttonTint="@color/rgb_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page_margin_medium_label"
                android:textColor="@color/pdf_studio_dark_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page_margin_medium_desc"
                android:textColor="@color/pdf_studio_secondary_gray"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Large -->
    <LinearLayout
        android:id="@+id/rowMarginLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="@drawable/bg_merge_page_size_selected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_sm">

        <RadioButton
            android:id="@+id/radioMarginLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:buttonTint="@color/rgb_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page_margin_large_label"
                android:textColor="@color/pdf_studio_dark_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page_margin_large_desc"
                android:textColor="@color/pdf_studio_secondary_gray"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
