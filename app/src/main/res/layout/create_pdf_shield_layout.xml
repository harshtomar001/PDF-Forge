<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/bottom_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginLeft="@dimen/margin_18dp"
    android:layout_marginRight="@dimen/margin_18dp"
    android:layout_marginBottom="@dimen/margin_5dp"
    android:padding="@dimen/margin_5dp"
    android:background="@drawable/shield_bg"
    app:layout_constraintEnd_toEndOf="parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <ImageView
        android:id="@+id/shield_imageView"
        android:layout_height="@dimen/margin_40dp"
        android:layout_width="@dimen/margin_40dp"
        android:src="@drawable/shield_checkmark_red"
        android:layout_marginLeft="@dimen/margin_20dp"
        />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_marginLeft="@dimen/margin_8dp"
        >

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:textStyle="bold"
            android:alpha=".6"
            android:textColor="@color/black"
            android:text="@string/yourFileProtect"
            />

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:alpha="0.8"
            android:text="@string/safe_with_us"
            android:textColor="@color/grey"

            />



    </LinearLayout>



</LinearLayout>