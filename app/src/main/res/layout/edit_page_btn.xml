<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/upload_btn_edit_pdf"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="@string/upload_pdf"
        android:background="@drawable/createpdf_btn_gradient_bg"
        app:backgroundTint="@null"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/white"
        android:paddingRight="7dp"
        android:paddingLeft="7dp"
        app:icon="@drawable/pdf_upload"
        app:iconTint="@null"

        app:iconGravity="textStart"
        app:cornerRadius="11dp"
        app:iconSize="26dp"
        />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/generate_pdf_edit_pdf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/createpdf_btn_gradient_bg"
        app:iconTint="@null"
        app:backgroundTint="@null"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/white"
        android:text="@string/generate_pdf"
        app:icon="@drawable/pdf_fevicon"
        android:paddingRight="7dp"
        android:paddingLeft="7dp"
        app:cornerRadius="11dp"
        android:layout_marginLeft="9dp"
        app:iconSize="26dp"


        />


</LinearLayout>