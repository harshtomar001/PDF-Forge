<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <FrameLayout
        android:id="@+id/rotatePDF_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/margin_18dp"
        android:background="@drawable/toolbar_bg_rotp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        >

        <ImageView

            android:id="@+id/back_arrow_rotate_pdf_output"
            android:layout_width="@dimen/margin_40dp"
            android:layout_height="@dimen/margin_40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="-5dp"
            app:srcCompat="@drawable/ic_back_arrow" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_50dp"
            >

            <TextView
                android:id="@+id/output_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotatePDF"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/output_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotate_pdf_title_text"
                android:textSize="@dimen/margin_10dp"
                android:alpha="0.7"
                android:textColor="@color/white"/>

        </LinearLayout>
        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="@dimen/margin_60dp"
            android:layout_height="@dimen/margin_60dp"
            android:alpha="0.4"
            android:layout_gravity="right"
            app:srcCompat="@drawable/reverse_pdf_icon_fixed" />
        <ImageView

            android:layout_width="@dimen/margin_60dp"
            android:layout_height="@dimen/margin_60dp"
            android:alpha="0.2"
            android:layout_gravity="center|bottom"
            app:srcCompat="@drawable/reverse_pdf_icon_fixed" />

    </FrameLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/rotatePDF_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        >



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


    <ImageView
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        app:srcCompat="@drawable/rotated_pdf_out"
        app:layout_constraintTop_toBottomOf="@id/rotatePDF_toolbar"

         />

    <LinearLayout
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="@dimen/margin_20dp"
        app:layout_constraintTop_toBottomOf="@+id/img"
        >

        <TextView
            android:id="@+id/pdf_rev_rot_success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textSize="@dimen/margin_24dp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/black"
            android:fontFamily="@font/inter_medium"
            android:text="@string/pdf_rotated_successfully"
            tools:ignore="SpUsage" />

        <TextView
            android:id="@+id/ready_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_margin="@dimen/margin_20dp"
            android:textSize="@dimen/margin_18dp"
            android:textColor="@color/black"
            android:text="@string/your_pdf_is_rotated_and_is_ready_to_download"
            tools:ignore="SpUsage"
            android:alpha="0.8"/>




    </LinearLayout>


    <com.google.android.material.card.MaterialCardView

        android:id="@+id/pdf_View"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_20dp"
        android:layout_marginRight="@dimen/margin_20dp"
        app:layout_constraintTop_toBottomOf="@+id/text"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="@dimen/margin_20dp"
        app:strokeWidth="0dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/margin_5dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/pdf_icon"
            android:layout_width="@dimen/margin_60dp"
            android:layout_height="@dimen/margin_60dp"
            app:srcCompat="@drawable/pdf_icon_path_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_12dp"
            android:orientation="vertical"
            android:layout_weight="1"
            >

            <TextView
                android:id="@+id/pdfName_rot_pdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="pdfName.pdf"
                android:textColor="@color/black"
                android:textSize="@dimen/margin_18dp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_marginTop="@dimen/margin_5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:alpha="0.6">


                <TextView
                    android:id="@+id/pdfSize_rot_pdf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.35 MB"
                    android:textColor="@color/black"/>

                <ImageView
                    android:id="@+id/imageView10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin_8dp"
                    android:layout_marginRight="@dimen/margin_8dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/dot_inactive" />

                <TextView
                    android:id="@+id/pdfPages_rot_pdf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 Pages"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:textColor="@color/black" />




            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:background="@drawable/success_bg_rot_pdf"
                android:padding="@dimen/margin_5dp"
                android:layout_marginTop="@dimen/margin_8dp">

                <ImageView
                    android:id="@+id/imageView11"
                    android:layout_width="@dimen/margin_20dp"
                    android:layout_height="@dimen/margin_20dp"
                    app:srcCompat="@drawable/success_icon_svg" />

                <TextView

                    android:id="@+id/textView9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Completed"
                    android:textStyle="bold"
                    android:textColor="#3cfa5f"
                    android:layout_marginLeft="@dimen/margin_5dp"
                    />

            </LinearLayout>


        </LinearLayout>


        <ImageView
            android:layout_marginTop="@dimen/margin_5dp"
            android:layout_height= "@dimen/margin_60dp"
            android:layout_width="@dimen/margin_60dp"
            android:id="@+id/viewPDF_rot_pdf"
            android:src="@drawable/view_icon"
            android:layout_marginRight="@dimen/margin_12dp"
            />





    </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/download_rotate_pdf"
        android:layout_width="match_parent"
        android:layout_margin="@dimen/margin_20dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/margin_8dp"
        android:background="@drawable/rotate_btn_bg_rotp"
        app:layout_constraintTop_toBottomOf="@id/pdf_View">


        <ImageView
            android:layout_width="@dimen/margin_50dp"
            android:layout_height="@dimen/margin_50dp"
            app:srcCompat="@drawable/download_icon_no_bg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Download"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="@dimen/margin_22dp"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sharePDF_rotatePDF"
        android:layout_width="match_parent"
        android:layout_marginLeft="@dimen/margin_20dp"
        android:layout_marginRight="@dimen/margin_20dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/margin_8dp"
        android:background="@drawable/btn_bg_rotp"
        >

        <ImageView
            android:id="@+id/share_img"
            android:layout_width="@dimen/margin_50dp"
            android:layout_height="@dimen/margin_50dp"
            app:srcCompat="@drawable/share_icon_updated"
            android:layout_marginRight="@dimen/margin_8dp"
            />

        <TextView
            android:id="@+id/share_textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share PDF"
            android:textColor="@color/purple"
            android:textStyle="bold"
            android:textSize="@dimen/margin_22dp"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/redirecting_inp_frag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="@dimen/margin_60dp"
        android:layout_marginTop="@dimen/margin_12dp"
        android:layout_marginBottom="@dimen/margin_20dp"
        android:layout_marginRight="@dimen/margin_60dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/rotate_another"
            android:layout_width="@dimen/margin_30dp"
            android:layout_height="@dimen/margin_30dp"
            app:srcCompat="@drawable/rotate_arrow_bgless" />

        <TextView
            android:id="@+id/rot_rev_another"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rotate_another_pdf"
            android:textSize="@dimen/margin_12dp"
            android:textColor="@color/purple"
            android:layout_marginLeft="@dimen/margin_8dp"
            />


    </LinearLayout>

            <View android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_width="0dp" />

    <LinearLayout

        android:id="@+id/bottom_section_"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="@dimen/margin_18dp"
        android:layout_marginRight="@dimen/margin_18dp"
        android:layout_marginBottom="@dimen/margin_20dp"
        android:padding="@dimen/margin_5dp"
        android:background="@drawable/sheild_bg_rotp">


        <ImageView

            android:id="@+id/shield_image"
            android:layout_height="@dimen/margin_50dp"
            android:layout_width="@dimen/margin_50dp"
            android:src="@drawable/shield_check_icon"
            android:layout_marginLeft="@dimen/margin_40dp" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_marginLeft="@dimen/margin_8dp">


            <TextView
                android:id="@+id/shield_main_text"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:textStyle="bold"
                android:alpha=".8"
                android:textColor="@color/purple"
                android:text="@string/yourFileProtect"
                />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:alpha="0.4"
                android:text="@string/safe_with_us"
                android:textColor="@color/black"

                />



        </LinearLayout>



    </LinearLayout>


        </LinearLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
