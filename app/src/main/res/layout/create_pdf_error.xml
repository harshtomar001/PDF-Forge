<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ===================== TOP BAR ===================== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_home_page"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/backArrow"
            android:layout_width="@dimen/margin_30dp"
            android:layout_height="@dimen/margin_30dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Error"
            android:textSize="@dimen/margin_20dp"
            android:paddingStart="@dimen/margin_8dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- ===================== SCROLLABLE CONTENT ===================== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar_home_page"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Gradient header + icon -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/header_height"
                android:background="@drawable/bg_error_header_gradient">

                <FrameLayout
                    android:layout_width="@dimen/status_circle_size"
                    android:layout_height="@dimen/status_circle_size"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_error_circle"
                    android:elevation="2dp">

                    <ImageView
                        android:id="@+id/errorIcon"
                        android:layout_width="@dimen/status_icon_size"
                        android:layout_height="@dimen/status_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_error_icon"
                        android:src="@drawable/ic_error"
                        app:tint="@color/error_red" />
                </FrameLayout>
            </FrameLayout>

            <!-- Title / subtitle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:paddingTop="@dimen/spacing_sm">

                <TextView
                    android:id="@+id/errorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/error_title"
                    android:textColor="@color/error_red"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/errorSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:text="@string/error_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_subtitle" />
            </LinearLayout>

            <!-- Card + illustration + buttons (horizontal padding applied here) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg">

                <!-- Error details card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/errorDetailsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    app:cardBackgroundColor="@color/error_red_light"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/detail_icon_size"
                                android:layout_height="@dimen/detail_icon_size"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_warning"
                                app:tint="@color/error_red" />

                            <TextView
                                android:id="@+id/errorDetailsTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:text="@string/error_details_title"
                                android:textColor="@color/error_red"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/errorMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_body"
                            tools:text="We couldn't create the PDF.\nPlease try again." />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Decorative illustration strip (purely visual, no IDs / no dynamic data) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:alpha="0.35"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_doc_outline"
                        app:tint="@color/error_red" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@color/card_stroke" />

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:alpha="0.35"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_doc_sad"
                            app:tint="@color/error_red" />

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="bottom|end"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_x_circle"
                            app:tint="@color/error_red" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Primary action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tryAgain"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:backgroundTint="@color/pdf_red"
                    android:text="@string/action_try_again"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/button_corner_radius"
                    app:icon="@drawable/ic_refresh"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />

                <!-- Secondary action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/createAnotherPdf"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/action_create_another"
                    android:textAllCaps="false"
                    android:textColor="@color/pdf_red"
                    app:cornerRadius="@dimen/button_corner_radius"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconTint="@color/pdf_red"
                    app:strokeColor="@color/pdf_red" />

                <!-- Tertiary action: filled neutral gray, matching the reference -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/back"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:backgroundTint="@color/neutral_button_bg"
                    android:text="@string/action_back"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    app:cornerRadius="@dimen/button_corner_radius"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconTint="@color/black"
                    app:elevation="0dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
