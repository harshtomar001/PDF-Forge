<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="0dp"
    android:background="#F0F0F0"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <include
        android:id="@+id/toolbar_edit_pdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/edit_pdf_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/initial_no_pdf_sel_upl_pdf"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_edit_pdf"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/noPdfImage"
            android:layout_width="270dp"
            android:layout_height="270dp"
            android:src="@drawable/edit_pdf_icon"
            android:contentDescription="Edit PDF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="80dp"/>

        <TextView
            android:id="@+id/titleTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No PDF Selected"
            android:textStyle="bold"
            android:textSize="24sp"
            android:textColor="#111827"
            app:layout_constraintTop_toBottomOf="@id/noPdfImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/subtitleTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Choose a PDF to start editing pages, rotate, delete, reorder and more."
            android:textSize="15sp"
            android:textColor="#6B7280"
            android:gravity="center"
            android:maxLines="2"
            app:layout_constraintTop_toBottomOf="@id/titleTxt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/uploadPdfBtn"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="Upload PDF"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:icon="@drawable/upload_sign"
            app:iconTint="@android:color/white"
            app:iconGravity="textStart"
            app:cornerRadius="18dp"
            app:backgroundTint="@null"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_edit_pdf_upload"
            app:layout_constraintTop_toBottomOf="@id/subtitleTxt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/supportTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Supported: PDF files only"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/uploadPdfBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/preview_box"
        layout="@layout/edit_pdf_pdf_preview_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10dp"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        android:layout_marginBottom="@dimen/margin_20dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_edit_pdf" />

    <LinearLayout
        android:id="@+id/btns.."
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="@dimen/margin_10dp"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/preview_box">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:orientation="horizontal">


            <CheckBox
                android:layout_width="20dp"
                android:layout_height="20dp" />

            <TextView
                android:id="@+id/selectAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_8dp"
                android:text="Select All"
                android:textSize="14dp"
                android:textColor="@color/darkGray"
                android:textStyle="bold"
                />

        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            />


        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="@color/darkGray"
            app:srcCompat="@drawable/three_dot_vertical" />




    </LinearLayout>

    <LinearLayout
        android:id="@+id/tip_layout"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:layout_marginStart="@dimen/margin_20dp"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_marginEnd="@dimen/margin_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/btns..">

        <ImageView
            android:layout_width="@dimen/margin_24dp"
            android:layout_height="@dimen/margin_24dp"
            android:src="@drawable/ic_lightbulb"
            android:tint="@color/darkGray"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/margin_12dp"
            android:textColor="@color/darkGray"
            android:layout_marginStart="@dimen/margin_5dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Tap a page to select. Long press and drag to reorder."
            />


    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_edit_pdf"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tip_layout"
        android:layout_marginHorizontal="@dimen/margin_15dp"
        android:layout_marginTop="@dimen/margin_10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintBottom_toTopOf="@id/btns_layout"
        app:layout_constraintEnd_toEndOf="parent"

        />

    <include
        android:id="@+id/btns_layout"
        layout="@layout/edit_pdf_save_btns_"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/margin_12dp"
        android:layout_marginTop="@dimen/margin_12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>