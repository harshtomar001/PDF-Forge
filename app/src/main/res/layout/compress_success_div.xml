<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="20dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:id="@+id/green_tick"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/textContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">


        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/dot_orange"
            android:alpha="0.7"
            />

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/dot_green"
            android:alpha="0.5"
            android:layout_gravity="top|end"/>

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/dot_pink"
            android:alpha="0.6"
            android:layout_gravity="bottom|end"/>

        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/dot_blut"
            android:alpha="0.3"
            android:layout_gravity="start|center"/>

        <ImageView
            android:id="@+id/image_success"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/success_img"
            android:layout_gravity="center"/>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/textContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginStart="@dimen/margin_8dp"
        app:layout_constraintStart_toEndOf="@id/green_tick"
        app:layout_constraintEnd_toStartOf="@id/progress_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/cmp_completed_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pdf_compressed_successfully"
            android:textColor="#159947"
            android:textStyle="bold"
            android:textSize="16dp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/txtSavedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="You saved 19.3 MB (75%)"
            android:textColor="#5F6368"
            android:textSize="12dp"
            android:maxLines="4"
            android:maxWidth="110dp"
            android:ellipsize="end"/>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/progress_layout"
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ProgressBar
            android:id="@+id/circularProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="100"
            android:progress="75"
            android:progressDrawable="@drawable/circular_progress" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/txtProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75%"
                android:textSize="18dp"
                android:textColor="#4CAF50"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saved"
                android:textSize="11sp"
                android:textColor="#888888" />

        </LinearLayout>

    </FrameLayout>




</androidx.constraintlayout.widget.ConstraintLayout>