<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/pdf_studio_white"
    android:padding="@dimen/spacing_md">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/pdf_studio_divider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/merge_help_title"
        android:textColor="@color/pdf_studio_dark_navy"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:lineSpacingExtra="6dp"
        android:text="@string/merge_help_step_1"
        android:textColor="@color/pdf_studio_dark_navy"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/merge_help_step_2"
        android:textColor="@color/pdf_studio_dark_navy"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/merge_help_step_3"
        android:textColor="@color/pdf_studio_dark_navy"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/merge_help_step_4"
        android:textColor="@color/pdf_studio_dark_navy"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/merge_help_step_5"
        android:textColor="@color/pdf_studio_dark_navy"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHelpGotIt"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/merge_help_got_it"
        android:textAllCaps="false"
        android:textColor="@color/pdf_studio_white"
        app:backgroundTint="@color/rgb_red"
        app:cornerRadius="12dp" />

</LinearLayout>
