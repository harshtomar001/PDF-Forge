<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/parent_layout"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <include
        android:id="@+id/title_extractImg"
        layout="@layout/title_edit_img_page_inp_frag"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@color/white"
    android:fillViewport="true"
    >



<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">


    <include
        android:id="@id/upl_layout"
        layout="@layout/upload_pdf_layout_ep_cmp_pdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_20dp"
        android:layout_marginStart="@dimen/margin_20dp"
        android:layout_marginBottom="@dimen/margin_20dp"
        android:layout_marginEnd="@dimen/margin_20dp"
        android:padding="@dimen/margin_12dp"
        app:layout_constraintTop_toTopOf="parent"

        />



    <ImageView
        android:id="@+id/no_pdf_selected"
        android:layout_height="0dp"
        android:visibility="gone"
        android:scaleType="fitStart"
        android:layout_width="match_parent"
        android:src="@drawable/no_pdf_selected"
        app:layout_constraintTop_toBottomOf="@id/upl_layout"
        app:layout_constraintBottom_toTopOf="@id/extractImg_cardView"

        />

    <com.google.android.material.card.MaterialCardView

        android:id="@+id/pdf_preview_ex_img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_20dp"
        app:cardElevation="@dimen/margin_20dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/upl_layout"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/margin_8dp">


            <ImageView
                android:id="@+id/pdf_image"
                android:layout_width="@dimen/margin_50dp"
                android:layout_height="@dimen/margin_50dp"
                app:srcCompat="@drawable/pdf_fevicon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"



                />

            <TextView
                android:id="@+id/pdfName_ex_img"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="testing.pdf"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/pdf_sizes_ex_img"
                app:layout_constraintEnd_toStartOf="@id/croee_ex_img"
                app:layout_constraintStart_toEndOf="@id/pdf_image"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/pdf_sizes_ex_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.45 MB"
                android:textColor="@color/black"
                android:maxWidth="70dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:alpha="0.7"
                android:layout_marginTop="@dimen/margin_8dp"
                android:layout_marginStart="@dimen/margin_8dp"
                app:layout_constraintTop_toBottomOf="@id/pdfName_ex_img"
                app:layout_constraintStart_toEndOf="@id/pdf_image"/>

            <ImageView
                android:id="@+id/imageView14"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:textColor="@color/black"
                android:alpha="0.7"
                app:srcCompat="@drawable/dot_inactive"
                android:layout_marginLeft="@dimen/margin_8dp"
                android:layout_marginTop="@dimen/margin_10dp"
                app:layout_constraintTop_toBottomOf="@id/pdfName_ex_img"
                app:layout_constraintStart_toEndOf="@id/pdf_sizes_ex_img"
                app:layout_constraintEnd_toStartOf="@id/pdf_pages_ex_img"
                app:layout_constraintBottom_toBottomOf="parent"
                 />

            <TextView
                android:id="@+id/pdf_pages_ex_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 Pages"
                android:maxWidth="70dp"
                android:maxLines="1"
                android:textColor="@color/black"
                android:alpha="0.7"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/margin_8dp"
                android:layout_marginStart="@dimen/margin_8dp"
                app:layout_constraintTop_toBottomOf="@id/pdfName_ex_img"
                app:layout_constraintStart_toEndOf="@id/imageView14"
                app:layout_constraintBottom_toBottomOf="parent"
                />



            <ImageView
                android:id="@+id/croee_ex_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/cross_sign"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
               />
        </androidx.constraintlayout.widget.ConstraintLayout>




    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/margin_20dp"
        android:text="Options"
        android:layout_marginTop="@dimen/margin_18dp"
        app:layout_constraintTop_toBottomOf="@id/pdf_preview_ex_img"
        android:textColor="@color/black"
        android:textStyle="bold"

        />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/output_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/margin_50dp"
        android:layout_marginTop="@dimen/margin_12dp"
        android:layout_marginStart="@dimen/margin_20dp"
        android:layout_marginEnd="@dimen/margin_20dp"
        android:layout_marginBottom="@dimen/margin_18dp"
        android:paddingBottom="@dimen/margin_18dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintBottom_toTopOf="@id/extractImg_cardView">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/doc_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:srcCompat="@drawable/document_icon_blue_xml"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/margin_12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/page_range"
                android:layout_marginStart="@dimen/margin_18dp"
                 />

            <TextView
                android:id="@+id/page_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Page Range"
                android:textStyle="bold"
                android:textColor="@color/black"

                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/margin_18dp"
                app:layout_constraintStart_toEndOf="@id/doc_image"
                 />

            <RadioButton
                android:id="@+id/all_pages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Pages"
                android:minHeight="0dp"
                android:minWidth="0dp"
                app:buttonTint="#6246f0"
                android:textColor="@color/black"
                android:textSize="@dimen/margin_15dp"
                app:layout_constraintTop_toBottomOf="@id/doc_image"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="@dimen/margin_50dp"


                />

            <RadioButton
                android:id="@+id/custom_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"

                app:buttonTint="#6246f0"
                android:text="Custom Range"
                android:textColor="@color/black"
                android:textSize="@dimen/margin_15dp"
                app:layout_constraintTop_toBottomOf="@id/all_pages"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="@dimen/margin_50dp"/>



            <LinearLayout
                android:visibility="gone"
                android:id="@+id/from_to_layout"
                android:layout_marginTop="@dimen/margin_12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/custom_range"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="From"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:textSize="@dimen/margin_18dp"
                    android:textColor="@color/black"
                    android:alpha="0.7"
                    />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/black">


                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/firstPages"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ems="10"
                        android:textAlignment="center"
                        android:textSize="15sp"
                        android:padding="0dp"
                        android:textColor="@color/black"
                        android:inputType="number"

                        />


                </com.google.android.material.textfield.TextInputLayout>



                <TextView
                    android:id="@+id/textView10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="To"
                    android:layout_marginStart="@dimen/margin_20dp"
                    android:layout_marginEnd="@dimen/margin_20dp"
                    android:textSize="@dimen/margin_18dp"
                    android:textColor="@color/black"
                    android:alpha="0.7"
                    />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="64dp"
                    android:layout_height="@dimen/margin_40dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/black">


                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/totalPages"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ems="10"
                        android:textAlignment="center"
                        android:padding="0dp"
                        android:textColor="@color/black"
                        android:inputType="number" />


                </com.google.android.material.textfield.TextInputLayout>





            </LinearLayout>


            <View
                android:id="@+id/lineBreak"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/margin_20dp"
                android:layout_marginEnd="@dimen/margin_20dp"
                android:layout_marginTop="@dimen/margin_18dp"
                android:background="@color/black"
                android:alpha="0.3"
                app:layout_constraintTop_toBottomOf="@id/from_to_layout"

                />

            <ImageView
                android:id="@+id/imageView13"
                android:layout_width="@dimen/margin_40dp"
                android:layout_height="@dimen/margin_40dp"
                app:srcCompat="@drawable/image_icon_blue_mountain_fix"
                app:layout_constraintTop_toTopOf="@id/textView5"
                app:layout_constraintBottom_toBottomOf="@id/textView5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintVertical_bias="0.5"
                android:layout_marginStart="@dimen/margin_20dp"


                />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Image Quality"
                android:textSize="@dimen/margin_12dp"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/lineBreak"
                app:layout_constraintStart_toEndOf="@id/imageView13"
                android:layout_marginStart="@dimen/margin_8dp"
                app:layout_constraintBottom_toTopOf="@id/lineBreak1"

                />



            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginEnd="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="0"
                android:layout_marginBottom="11dp"
                app:layout_constraintTop_toBottomOf="@id/lineBreak"
                app:layout_constraintBottom_toTopOf="@id/lineBreak1"
                app:boxBackgroundMode="none"
                app:endIconMode="custom"
                app:endIconTint="@color/black"
                app:endIconDrawable="@drawable/chevron_down_icon_black">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/quality_dropdown"
                    android:layout_width="115dp"
                    android:maxWidth="115dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_height="match_parent"
                    android:text="Original Quality"
                    android:inputType="none"
                    android:alpha="0.6"
                    android:textSize="14dp"
                    android:textColor="@color/black"
                    android:paddingVertical="4dp"/>

            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:id="@+id/lineBreak1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/margin_20dp"
                android:layout_marginEnd="@dimen/margin_20dp"
                android:layout_marginTop="@dimen/margin_8dp"
                android:layout_marginBottom="@dimen/margin_20dp"
                android:background="@color/black"
                android:alpha="0.3"
                app:layout_constraintTop_toBottomOf="@id/imageView13" />


            <ImageView
                android:id="@+id/imageView15"
                android:layout_width="@dimen/margin_40dp"
                android:layout_height="@dimen/margin_40dp"
                android:layout_marginStart="@dimen/margin_20dp"
                android:layout_marginTop="@dimen/margin_12dp"
                app:srcCompat="@drawable/document_icon_blue_xml"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/textView6"
                app:layout_constraintBottom_toBottomOf="@id/textView6"/>


            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Image Format"
                android:textColor="@color/black"
                android:textSize="@dimen/margin_12dp"
                android:layout_marginTop="@dimen/margin_22dp"
                android:layout_marginStart="@dimen/margin_8dp"
                app:layout_constraintTop_toBottomOf="@id/lineBreak1"
                app:layout_constraintStart_toEndOf="@id/imageView15"/>



            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginEnd="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="0"
                android:layout_marginBottom="4dp"
                app:layout_constraintTop_toBottomOf="@id/lineBreak1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:boxBackgroundMode="none"
                app:endIconMode="custom"
                app:endIconTint="@color/black"
                app:endIconDrawable="@drawable/chevron_down_icon_black">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/format_dropdown"
                    android:layout_width="115dp"
                    android:maxWidth="115dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_height="match_parent"
                    android:text="Original Format"
                    android:inputType="none"
                    android:alpha="0.6"
                    android:textSize="14dp"
                    android:layout_marginBottom="5dp"
                    android:textColor="@color/black"
                    android:paddingVertical="4dp"/>

            </com.google.android.material.textfield.TextInputLayout>





        </androidx.constraintlayout.widget.ConstraintLayout>


    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/extractImg_cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#3D7BEF"
        app:strokeWidth="0dp"
        app:cardElevation="@dimen/margin_18dp"
        android:layout_margin="@dimen/margin_18dp"
        app:rippleColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">



        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/margin_5dp"
            android:orientation="horizontal">



            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="@dimen/margin_40dp"
                android:layout_height="@dimen/margin_40dp"
                app:srcCompat="@drawable/sparkle_icon_200x200" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Extract Images"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginStart="@dimen/margin_8dp"
                />





        </LinearLayout>




    </com.google.android.material.card.MaterialCardView>



</androidx.constraintlayout.widget.ConstraintLayout>


</ScrollView>


    <FrameLayout
        android:id="@+id/floatingFrameLayout"
        android:visibility="gone"
        android:layout_gravity="bottom"
        android:elevation="@dimen/margin_60dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <EditText
        android:id="@+id/floatingEdit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_50dp"
        android:inputType="number"
        android:cursorVisible="true"
        android:textCursorDrawable="@color/black"
        android:hapticFeedbackEnabled="true"
        android:textColorHint="@color/grey"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:padding="12dp"
        android:elevation="10dp"
        android:background="#FAE4E4" />

    </FrameLayout>


</LinearLayout>