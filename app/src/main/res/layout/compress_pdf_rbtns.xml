<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_marginStart="@dimen/margin_10dp"
    android:layout_marginEnd="@dimen/margin_10dp"
    android:layout_marginBottom="@dimen/margin_10dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp"
    app:cardCornerRadius="@dimen/margin_15dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">




    <androidx.constraintlayout.widget.ConstraintLayout

        android:id="@+id/radioBtn_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/radio_btn_un_cmp_p"
        android:orientation="horizontal">


        <RadioButton
            android:id="@+id/compression_radioBtn"
            android:layout_width="@dimen/margin_30dp"
            android:layout_height="@dimen/margin_30dp"
            android:layout_marginStart="5dp"
            android:scaleX="1.5"
            android:scaleY="1.5"
            android:clickable="false"
            android:focusable="false"
            app:buttonTint="@color/radio_selector"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <LinearLayout
            android:id="@+id/layout123"
            android:layout_width="0dp"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_8dp"
            app:layout_constraintTop_toTopOf="@id/compression_radioBtn"
            app:layout_constraintStart_toEndOf="@id/compression_radioBtn"
            app:layout_constraintEnd_toStartOf="@id/quality"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintBottom_toBottomOf="@id/compression_radioBtn"
            >

        <TextView
            android:id="@+id/compression_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Low Compression"
            android:textSize="@dimen/margin_16dp"
            android:textStyle="bold"
            android:maxWidth="140dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/black"
            android:layout_marginBottom="4dp"

            />

        <TextView
            android:id="@+id/compression_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Better Quality, Larger Size"
            android:textColor="@color/black"
            android:alpha="0.7"
            android:maxWidth="145dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="@dimen/margin_12dp"
            />

        </LinearLayout>

        <TextView
            android:id="@+id/quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="~ 90% Quality"
            android:paddingTop="@dimen/margin_10dp"
            android:paddingBottom="@dimen/margin_10dp"
            android:paddingStart="@dimen/margin_10dp"
            android:paddingEnd="@dimen/margin_10dp"
            android:background="@drawable/quality_90_bg"
            android:textColor="#30a64d"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"

            android:layout_marginEnd="@dimen/margin_5dp"
            android:textSize="@dimen/margin_10dp"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

