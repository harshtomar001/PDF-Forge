<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/create__pdf"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <include
        android:id="@+id/create_pdf_toolbar"
        layout="@layout/create_pdf_title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/upload_btn"
        />


    <include
            android:id="@+id/upload_btn"
            layout="@layout/create_pdf_btn"
            android:layout_height="170dp"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:paddingBottom="@dimen/margin_12dp"
            android:layout_marginEnd="@dimen/margin_20dp"
            app:layout_constraintTop_toBottomOf="@id/create_pdf_toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

        />


    <ImageView
        android:id="@+id/empty_image"
        android:layout_width="wrap_content"
        android:layout_height="450dp"
        android:visibility="visible"
        android:src="@drawable/no_image_selected"
        app:layout_constraintTop_toBottomOf="@+id/upload_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintEnd_toEndOf="parent" />


    <LinearLayout
        android:id="@+id/selected_meta"
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        android:visibility="gone"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        android:layout_marginTop="@dimen/margin_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/upload_btn">


        <TextView
            android:id="@+id/selected_img_count"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Selected Images (0)"
            android:textColor="@color/black"
            android:textSize="@dimen/margin_16dp"
            android:layout_gravity="start"
            android:textStyle="bold"
            android:layout_weight="1"
            />

        <TextView
            android:id="@+id/clear_all"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Clear All"
            android:textColor="@color/rgb_red"
            android:textSize="@dimen/margin_16dp"
            android:layout_gravity="end"
            android:textStyle="bold"
            />


    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/create_pdf_view_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:layout_marginTop="@dimen/margin_15dp"
        app:layout_constraintTop_toBottomOf="@id/selected_meta"
        app:layout_constraintBottom_toTopOf="@id/recyclerview_for_pdf"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview_for_pdf"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        android:layout_marginStart="@dimen/margin_18dp"
        app:layout_constraintTop_toBottomOf="@id/create_pdf_view_recycler_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottom_section"
        app:layout_constraintEnd_toEndOf="parent"/>


    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/create_pdf_shield_layout"
        app:layout_constraintBottom_toTopOf="@id/generate_pdf"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/bottom_section"
        android:visibility="gone"
        android:layout_marginLeft="@dimen/margin_18dp"
        android:layout_marginRight="@dimen/margin_18dp"
        android:layout_marginBottom="@dimen/margin_5dp"
        android:layout_marginTop="@dimen/margin_8dp"

        />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:visibility="gone"
        android:orientation="horizontal"
        android:id="@+id/generate_pdf"
        android:padding="@dimen/margin_8dp"
        android:background="@drawable/generate_pdf_bg"
        android:layout_marginLeft="@dimen/margin_18dp"
        android:layout_marginRight="@dimen/margin_18dp"
        android:layout_marginBottom="@dimen/margin_18dp"
        android:layout_marginTop="@dimen/margin_5dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="@dimen/margin_40dp"
            android:layout_height="@dimen/margin_40dp"
            android:src="@drawable/pdf_icon_android"
            android:layout_marginLeft="@dimen/margin_12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/generate_pdf"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/generate_pdf_from_n_pages"
                android:textColor="@color/white"
                android:id="@+id/n_pages"
                android:alpha="0.9"
                android:textSize="10sp"
                android:textStyle="normal"
                />





        </LinearLayout>

        <ImageView
            android:layout_height="@dimen/margin_30dp"
            android:layout_width="@dimen/margin_30dp"
            android:src="@drawable/right_arrow"
            app:tint="@color/white" />



    </LinearLayout>


    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:indeterminate="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/generating_pdf"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:layout_marginTop="12dp"/>

        </LinearLayout>
    </FrameLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loader_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <!-- Page 1 -->
        <View
            android:id="@+id/page1"
            android:layout_width="32dp"
            android:layout_height="38dp"
            android:background="@drawable/loader_page_stack_rect"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.41"
            app:layout_constraintVertical_bias="0.42" />

        <!-- Page 2 -->
        <View
            android:id="@+id/page2"
            android:layout_width="32dp"
            android:layout_height="38dp"
            android:background="@drawable/loader_page_stack_rect"
            app:layout_constraintTop_toTopOf="@id/page1"
            app:layout_constraintBottom_toBottomOf="@id/page1"
            app:layout_constraintStart_toEndOf="@id/page1"
            android:layout_marginStart="4dp" />

        <!-- Page 3 -->
        <View
            android:id="@+id/page3"
            android:layout_width="32dp"
            android:layout_height="38dp"
            android:background="@drawable/loader_page_stack_rect"
            app:layout_constraintTop_toTopOf="@id/page2"
            app:layout_constraintBottom_toBottomOf="@id/page2"
            app:layout_constraintStart_toEndOf="@id/page2"
            android:layout_marginStart="4dp" />

        <!-- Animated Ring -->
        <ImageView
            android:id="@+id/loaderRing"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:src="@drawable/loader_ring_animated"
            android:visibility="gone"
            android:contentDescription="@null"
            app:layout_constraintTop_toBottomOf="@id/page2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="18dp" />

        <!-- Loading Text -->
        <TextView
            android:id="@+id/loaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Processing PDF..."
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#D85A30"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/loaderRing"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <WebView
        android:id="@+id/pdfLoader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>