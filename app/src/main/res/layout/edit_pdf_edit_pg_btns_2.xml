<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:padding="@dimen/margin_8dp"
    android:background="@drawable/edt_pdf_pg_tool_bg"
    android:orientation="horizontal">


    <LinearLayout
        android:id="@+id/waterMark_Layout"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/margin_40dp"
            android:layout_height="@dimen/margin_40dp"
            app:srcCompat="@drawable/edit_pdf_watermark_1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="@dimen/margin_15dp"
            android:textColor="@color/darkGray"
            android:text="Watermark" />


    </LinearLayout>


    <LinearLayout
        android:id="@+id/cropLayout"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/margin_40dp"
            android:layout_height="@dimen/margin_40dp"
            android:scaleType="center"
            android:tint="@color/darkGray"
            app:srcCompat="@drawable/edit_pdf_crop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="@dimen/margin_15dp"
            android:textColor="@color/darkGray"
            android:text="Crop" />


    </LinearLayout>


    <LinearLayout
        android:id="@+id/deleteLayout"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/margin_40dp"
            android:layout_height="@dimen/margin_40dp"
            app:srcCompat="@drawable/delete_tray_red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="@dimen/margin_15dp"
            android:textColor="@color/darkGray"
            android:text="Delete" />


    </LinearLayout>


    <LinearLayout
        android:id="@+id/moreToolsLayout"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/margin_40dp"
            android:layout_height="@dimen/margin_40dp"
            app:srcCompat="@drawable/three_dot_horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="@dimen/margin_15dp"
            android:textColor="@color/darkGray"
            android:text="More Tools" />


    </LinearLayout>




</LinearLayout>