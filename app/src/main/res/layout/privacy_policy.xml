<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView android:layout_height="0dp"
        android:layout_width="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/margin_50dp">


    <TextView
        android:id="@+id/privacyPolicy_textView"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/margin_50dp"
        android:layout_marginLeft="@dimen/margin_20dp"
        android:layout_marginRight="@dimen/margin_20dp"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:lineSpacingExtra="4dp"
        android:paddingBottom="@dimen/margin_24dp"
        android:lineSpacingMultiplier="1.2"
        android:fontFamily="@font/iosevka_charonmono_mediumitalic"
        android:textSize="15sp"
        android:layout_marginBottom="@dimen/margin_8dp"



        />

    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>