<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/edit_page_gradient_bg">


    <LinearLayout
        android:id="@+id/ll1_edit_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:background="@color/primary_col_btn"
        >

        <ImageView
            android:id="@+id/back_arrow_edit_page"
            android:layout_width="@dimen/margin_50dp"
            android:layout_height="@dimen/margin_50dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:padding="5dp"
            app:srcCompat="@drawable/ic_back_arrow" />

        <TextView
            android:id="@+id/edit_page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit PDF"
            android:textSize="28sp"
            android:layout_marginRight="60dp"
            android:textAlignment="center"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_vertical"
            android:textColor="@color/white"
            android:textStyle="bold"
            />

    </LinearLayout>


    <include
        android:id="@+id/include_edit_btn"
        layout="@layout/edit_page_btn"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/ll1_edit_page"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"

    />

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/recycler_view_edit_pdf"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/include_edit_btn"

    />
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/recycler_view_output_pdf"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/recycler_view_edit_pdf"

        />

    <androidx.recyclerview.widget.RecyclerView
        android:layout_height="0dp"
        android:layout_width="match_parent"
        android:id="@+id/recyclerView_preview_images"
        app:layout_constraintTop_toBottomOf="@+id/recycler_view_output_pdf"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/margin_30dp"
        >


    </androidx.recyclerview.widget.RecyclerView>

    <include layout="@layout/loading_bar"
        android:id="@+id/loading_overlay1" />




</androidx.constraintlayout.widget.ConstraintLayout>