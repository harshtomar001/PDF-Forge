<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView

    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="150dp"
    android:layout_width="match_parent"
    android:layout_marginStart="@dimen/margin_5dp"
    android:layout_marginEnd="@dimen/margin_5dp"
    android:layout_marginBottom="@dimen/margin_10dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_width="match_parent">


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp">

            <ImageView
                android:id="@+id/image_preview_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/green_tick_with_shadow"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/removeBtn_1"
                android:layout_width="30dp"
                android:layout_height="@dimen/margin_30dp"
                android:src="@drawable/cross"
                android:scaleType="centerCrop"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/circle_bg"
                android:layout_gravity="top|end" />

            <TextView
                android:id="@+id/image_size_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.34 MB"
                android:textSize="@dimen/margin_8dp"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="5dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/img_size_bg_ei_inp"
                android:textColor="@color/white"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:paddingLeft="@dimen/margin_5dp"
                android:paddingRight="@dimen/margin_5dp"
                android:textAlignment="center"
                android:textStyle="bold"
                android:alpha="0.7"
                tools:ignore="RtlCompat" />


            <TextView
                android:id="@+id/image_format_1"
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:text="PNG"
                android:textSize="@dimen/margin_8dp"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="@dimen/margin_5dp"
                android:background="@drawable/img_size_bg_ei_inp"
                android:textColor="@color/white"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:paddingLeft="@dimen/margin_5dp"
                android:paddingRight="@dimen/margin_5dp"
                android:textAlignment="center"
                android:textStyle="bold"
                android:alpha="0.7" />
        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>