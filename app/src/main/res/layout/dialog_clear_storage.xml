<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_clear_storage.xml

    Custom content view for the "Clear App Storage" dialog.
    Inflated and attached to a MaterialAlertDialogBuilder via setView().

    Title/subtitle/buttons are all part of this layout (rather than the
    builder's setTitle/setPositiveButton) so that:
      1) Typography can be fully controlled to match the App Storage screen.
      2) The CLEAR button can validate the selection and keep the dialog
         open (showing an inline error) instead of auto-dismissing.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/layoutClearStorageRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <!-- Title -->
        <TextView
            android:id="@+id/textDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear_storage_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/textDialogSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/clear_storage_subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/darkGray"
            android:alpha="0.7"
            />

        <!-- Options card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical">

                <!-- Row A: Generated PDF files -->
                <LinearLayout
                    android:id="@+id/rowGeneratedPdfs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkGeneratedPdfs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:buttonTint="@color/blue_checkBox"
                        app:buttonIconTint="@android:color/white"
                        app:useMaterialThemeColors="false"
                        android:clickable="false"
                        android:focusable="false" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/option_pdf_title"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/black"
                            android:textStyle="bold"

                            />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/option_pdf_description"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/darkGray"
                            android:alpha="0.7"
                            />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textPdfSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/blue_checkBox"
                        android:textStyle="bold"
                        tools:text="2.10 GB" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Row B: Cache -->
                <LinearLayout
                    android:id="@+id/rowCache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkCache"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:buttonTint="@color/blue_checkBox"
                        app:buttonIconTint="@android:color/white"
                        app:useMaterialThemeColors="false"
                        android:clickable="false"
                        android:focusable="false" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/option_cache_title"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/option_cache_description"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/darkGray"
                            android:alpha="0.7"
                            />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textCacheSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/blue_checkBox"
                        android:textStyle="bold"
                        tools:text="50 MB" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Row C: Other app data -->
                <LinearLayout
                    android:id="@+id/rowOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkOther"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:clickable="false"
                        android:focusable="false"
                        app:useMaterialThemeColors="false"
                        app:buttonTint="@color/blue_checkBox"
                        app:buttonIconTint="@android:color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/option_other_title"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/option_other_description"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/darkGray"
                            android:alpha="0.7"
                            />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textOtherSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/blue_checkBox"
                        android:textStyle="bold"
                        tools:text="10 MB" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Inline validation message, hidden by default -->
        <TextView
            android:id="@+id/textSelectionError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/clear_storage_error_none_selected"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/rgb_red"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Button row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginEnd="@dimen/margin_12dp"
                android:layout_weight="1"
                app:cornerRadius="@dimen/margin_12dp"
                android:text="@string/action_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClear"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/blue_checkBox"
                android:layout_marginStart="8dp"
                android:minWidth="48dp"
                android:textStyle="bold"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:textColor="@color/white"
                app:cornerRadius="@dimen/margin_12dp"
                android:text="@string/action_clear"
                />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
