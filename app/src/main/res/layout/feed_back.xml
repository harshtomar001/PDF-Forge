<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#e3ebfa"
    xmlns:android="http://schemas.android.com/apk/res/android">

<ScrollView
    android:id="@+id/scrool"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toTopOf="@+id/submitFeedBack">



<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/back_arrow_feedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Feedback"
        app:titleCentered="true"
        app:titleTextAppearance="@style/BoldToolbarTitle"
        android:background="@color/statusBarColor"
        app:navigationIcon="@drawable/ic_back_arrow"
        android:paddingTop="@dimen/margin_18dp"
        android:paddingBottom="@dimen/margin_8dp" />

    <androidx.cardview.widget.CardView
        android:layout_height="150dp"
        android:layout_width="150dp"
        app:cardCornerRadius="80dp"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/margin_20dp"
        android:elevation="@dimen/margin_18dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/feedback_icon" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/margin_12dp"
        android:layout_marginBottom="@dimen/margin_8dp"
        android:layout_gravity="center"
        android:text="@string/feedbackQuote"
        android:layout_marginLeft="@dimen/margin_60dp"
        android:layout_marginRight="@dimen/margin_60dp"
        android:textAlignment="center"
        android:paddingRight="@dimen/margin_40dp"
        android:paddingLeft="@dimen/margin_40dp"
        android:textColor="@color/black"
        android:fontFamily="@font/iosevka_charonmono_mediumitalic"
        />


    <com.google.android.material.card.MaterialCardView
        android:layout_marginRight="@dimen/margin_20dp"
        android:layout_marginLeft="@dimen/margin_20dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/margin_12dp"
        android:layout_width="match_parent"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="#7C3AED"
        app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_12dp"
            android:layout_marginLeft="@dimen/margin_30dp"
            android:text="@string/rateExpr"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:alpha="0.6"
            />

    <RatingBar

        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="1"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_gravity="center"
        android:progressTint="#23fabd"
        android:progressBackgroundTint="#BDAAAA"
        android:secondaryProgressTint="#23fabd"/>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/margin_12dp">

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="@string/poor"
            android:textColor="@color/black"
            android:layout_marginRight="140dp"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/excellent"
            android:textColor="@color/black"
            />

        </LinearLayout>

    </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:layout_marginTop="@dimen/margin_20dp"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_gravity="left"
        android:layout_marginLeft="@dimen/margin_20dp"
        android:text="@string/tellUsMore"
        android:textColor="@color/black"
        android:textSize="18sp"
        />



    <com.google.android.material.card.MaterialCardView
        android:layout_height="120dp"
        android:layout_width="match_parent"
        app:cardCornerRadius="@dimen/margin_12dp"
        android:layout_marginTop="@dimen/margin_10dp"
        android:layout_marginLeft="@dimen/margin_20dp"
        android:layout_marginRight="@dimen/margin_20dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="#7C3AED"
        app:strokeWidth="2dp">

        <EditText
            android:id="@+id/editText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:gravity="start|top"
            android:textColor="@color/black"
            android:textStyle="italic"
            android:fontFamily="@font/inconsolata_condensed_bold"
            android:hint="@string/writeFeedbackHere"
            android:textColorHint="@color/grey"
            android:inputType="textMultiLine"
            android:background="@android:color/transparent"/>

    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:layout_marginLeft="@dimen/margin_20dp"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="@string/feedbackAbout"
        android:layout_marginTop="@dimen/margin_20dp"
        android:textColor="@color/black"
        android:layout_marginBottom="@dimen/margin_12dp"

        />

    <GridLayout
        android:id="@+id/gridLayout"
        android:columnCount="4"
        android:layout_marginBottom="@dimen/margin_12dp"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_marginLeft="@dimen/margin_20dp"
        android:layout_marginRight="@dimen/margin_20dp"
        android:gravity="center"
        android:layout_gravity="center"
        android:paddingTop="@dimen/margin_12dp"
        android:paddingBottom="@dimen/margin_12dp">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="#c1d3f7"
            app:strokeWidth="2dp"
            android:clickable="true"
            android:focusable="true"
            android:checkable="true"
            android:layout_marginTop="@dimen/margin_8dp"
            android:layout_marginRight="@dimen/margin_8dp"
            android:id="@+id/featuresCard"
            >

            <LinearLayout
                android:layout_height="match_parent"
                android:layout_width="match_parent"
                android:gravity="center"
                android:orientation="vertical">


                <ImageView
                    android:layout_height="@dimen/margin_50dp"
                    android:layout_width="@dimen/margin_50dp"
                    android:src="@drawable/icon_features"
                    android:layout_gravity="center_horizontal"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/features"
                    android:layout_marginTop="@dimen/margin_5dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/black"
                    android:id="@+id/featuresTextBox"
                    />

            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginRight="@dimen/margin_8dp"
            android:layout_marginTop="@dimen/margin_8dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="#c1d3f7"
            app:strokeWidth="2dp"
            android:clickable="true"
            android:focusable="true"
            android:checkable="true"
            android:id="@+id/bugsCard"
            >

            <LinearLayout
                android:layout_height="match_parent"
                android:layout_width="match_parent"
                android:gravity="center"
                android:orientation="vertical">


            <ImageView
                android:layout_height="@dimen/margin_50dp"
                android:layout_width="@dimen/margin_50dp"
                android:src="@drawable/icon_bugs"
                android:layout_gravity="center_horizontal"

                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bugs"
                android:layout_marginTop="@dimen/margin_5dp"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/black"
                android:id="@+id/bugsTextBox"
                />

            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="@dimen/margin_8dp"
            android:layout_marginRight="@dimen/margin_8dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="#c1d3f7"
            app:strokeWidth="2dp"
            android:clickable="true"
            android:focusable="true"
            android:checkable="true"
            android:id="@+id/supportCard"
            >

            <LinearLayout
                android:layout_height="match_parent"
                android:layout_width="match_parent"
                android:gravity="center"
                android:orientation="vertical">


                <ImageView
                    android:layout_height="@dimen/margin_50dp"
                    android:layout_width="@dimen/margin_50dp"
                    android:src="@drawable/icon_support"
                    android:layout_gravity="center_horizontal"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/support"
                    android:layout_marginTop="@dimen/margin_5dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/black"
                    android:id="@+id/supportTextBox"

                    />

            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="@dimen/margin_8dp"

            app:cardBackgroundColor="@color/white"
            app:strokeColor="#c1d3f7"
            app:strokeWidth="2dp"
            android:clickable="true"
            android:focusable="true"
            android:checkable="true"
            android:id="@+id/otherCard"
            >

            <LinearLayout
                android:layout_height="match_parent"
                android:layout_width="match_parent"
                android:gravity="center"
                android:orientation="vertical">


                <ImageView
                    android:layout_height="@dimen/margin_50dp"
                    android:layout_width="@dimen/margin_50dp"
                    android:src="@drawable/icon_other_heart"
                    android:layout_gravity="center"
                    />

                <TextView
                    android:layout_marginTop="@dimen/margin_5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/others"
                    android:textColor="@color/black"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/othersTextBox"

                    />

            </LinearLayout>


        </com.google.android.material.card.MaterialCardView>


    </GridLayout>

    <View
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dp"

        />















</LinearLayout>


</ScrollView>


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submitFeedBack"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_marginLeft="@dimen/margin_15dp"
                    android:layout_marginRight="@dimen/margin_15dp"
                    app:cornerRadius="@dimen/margin_8dp"
                    android:layout_gravity="bottom"
                    android:shadowColor="@color/black"
                    android:elevation="@dimen/margin_15dp"
                    android:shadowRadius="@integer/material_motion_duration_medium_1"
                    app:icon="@drawable/send"
                    app:iconTint="@null"
                    android:layout_marginTop="@dimen/margin_20dp" android:layout_marginBottom="@dimen/margin_20dp"
                    app:iconGravity="textStart"
                    android:textSize="15sp"
                    android:padding="@dimen/margin_15dp"
                    android:text="@string/submitFeedback" app:layout_constraintTop_toBottomOf="@id/scrool" app:layout_constraintBottom_toTopOf="@id/bottom_sec"
                    >

                </com.google.android.material.button.MaterialButton>



    <LinearLayout
        android:id="@+id/bottom_sec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:padding="@dimen/margin_8dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="@dimen/margin_8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        >


        <ImageView
            android:layout_height="@dimen/margin_20dp"
            android:layout_width="@dimen/margin_20dp"
            android:src="@drawable/lock"
            android:alpha="0.3"
            />

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="@string/feedbackPrivate"
            android:layout_marginLeft="@dimen/margin_8dp"
            />
    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>