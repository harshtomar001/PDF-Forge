<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/Fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <FrameLayout
        android:id="@+id/frame_layout_progressBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/white"
                android:indeterminate="true"/>

            <TextView
                android:id="@+id/progressBar_textview"
                android:layout_marginTop="@dimen/margin_8dp"
                android:padding="@dimen/margin_12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Converting..."
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp"/>

        </LinearLayout>

    </FrameLayout>



    <LinearLayout
        android:id="@+id/loader_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        >

        <TextView
            android:id="@+id/extract_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Extracting Images..."
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/extract_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 images extracted"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"/>

        <ProgressBar
            android:id="@+id/exportProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="240dp"
            android:layout_height="10dp"
            android:layout_marginBottom="@dimen/margin_40dp"
            android:progressDrawable="@drawable/loader_progress_bar_blue"
            android:max="100"/>

    </LinearLayout>

</FrameLayout>