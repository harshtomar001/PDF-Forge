<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/loginScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/loginContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ============== BLUE HERO ============== -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/heroSection"
                android:layout_width="0dp"
                android:layout_height="@dimen/auth_hero_height"
                android:background="@drawable/bg_auth_hero"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/auth_back_button_size"
                    android:layout_height="@dimen/auth_back_button_size"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_marginTop="@dimen/auth_hero_top_inset"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_back_button"
                    android:padding="8dp"
                    android:src="@drawable/ic_back_arrow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Soft glow behind the illustration -->

                <View
                    android:id="@+id/illustrationGlow"
                    android:layout_width="@dimen/auth_illustration_glow_size"
                    android:layout_height="@dimen/auth_illustration_glow_size"
                    android:background="@drawable/bg_illustration_glow"
                    android:importantForAccessibility="no"
                    app:layout_constraintTop_toTopOf="@id/backButton"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Welcome headline + subtitle -->

                <LinearLayout
                    android:id="@+id/heroTextGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/auth_horizontal_margin"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/backButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/illustrationContainer"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintVertical_bias="0">

                    <TextView
                        android:id="@+id/welcomeLine1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:text="@string/welcome_line1"
                        android:textColor="@color/colorSurface"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/welcomeLine2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:text="@string/welcome_line2"
                        android:textColor="@color/colorBrandYellow"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/heroSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:includeFontPadding="false"
                        android:text="@string/login_hero_subtitle"
                        android:textColor="@color/colorHeroSubtitleText"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- Document / lock illustration -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/illustrationContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:importantForAccessibility="no"
                    app:layout_constraintTop_toBottomOf="@id/backButton"
                    app:layout_constraintEnd_toEndOf="parent">

                    <View
                        android:id="@+id/illustrationDocument"
                        android:layout_width="@dimen/auth_illustration_doc_width"
                        android:layout_height="@dimen/auth_illustration_doc_height"
                        android:layout_marginTop="18dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_illustration_document"
                        android:rotation="6"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/illustrationLine1"
                        android:layout_width="56dp"
                        android:layout_height="6dp"
                        android:layout_marginTop="52dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_illustration_line"
                        app:layout_constraintStart_toStartOf="@id/illustrationDocument"
                        app:layout_constraintTop_toTopOf="@id/illustrationDocument"
                        app:layout_constraintHorizontal_bias="0.28" />

                    <View
                        android:id="@+id/illustrationLine2"
                        android:layout_width="44dp"
                        android:layout_height="6dp"
                        android:layout_marginTop="66dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_illustration_line"
                        app:layout_constraintStart_toStartOf="@id/illustrationDocument"
                        app:layout_constraintTop_toTopOf="@id/illustrationDocument"
                        app:layout_constraintHorizontal_bias="0.28" />

                    <View
                        android:id="@+id/illustrationLine3"
                        android:layout_width="34dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="80dp"
                        android:background="@drawable/bg_illustration_line"
                        app:layout_constraintStart_toStartOf="@id/illustrationDocument"
                        app:layout_constraintTop_toTopOf="@id/illustrationDocument"
                        app:layout_constraintHorizontal_bias="0.28" />

                    <TextView
                        android:id="@+id/illustrationTag"
                        android:layout_width="@dimen/auth_illustration_tag_width"
                        android:layout_height="@dimen/auth_illustration_tag_height"
                        android:background="@drawable/bg_illustration_tag"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:rotation="-6"
                        android:text="@string/pdf"
                        android:textAllCaps="true"
                        android:textColor="@color/colorSurface"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/illustrationDocument"
                        app:layout_constraintTop_toTopOf="@id/illustrationDocument"
                        android:layout_marginStart="-6dp"
                        android:layout_marginTop="-8dp" />

                    <ImageView
                        android:id="@+id/illustrationLockBadge"
                        android:layout_width="@dimen/auth_illustration_badge_size"
                        android:layout_height="@dimen/auth_illustration_badge_size"
                        android:background="@drawable/bg_illustration_badge"
                        android:padding="14dp"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/colorSurface"
                        app:layout_constraintBottom_toBottomOf="@id/illustrationDocument"
                        app:layout_constraintEnd_toEndOf="@id/illustrationDocument" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <ImageView
                    android:id="@+id/sparkleTop"
                    android:layout_width="@dimen/auth_sparkle_size_large"
                    android:layout_height="@dimen/auth_sparkle_size_large"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    app:layout_constraintTop_toTopOf="@id/illustrationContainer"
                    app:layout_constraintEnd_toStartOf="@id/illustrationContainer" />

                <ImageView
                    android:id="@+id/sparkleMiddle"
                    android:layout_width="@dimen/auth_sparkle_size_small"
                    android:layout_height="@dimen/auth_sparkle_size_small"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    app:layout_constraintStart_toStartOf="@id/illustrationContainer"
                    app:layout_constraintTop_toTopOf="@id/illustrationContainer" />

                <ImageView
                    android:id="@+id/sparkleBottom"
                    android:layout_width="@dimen/auth_sparkle_size_small"
                    android:layout_height="@dimen/auth_sparkle_size_small"
                    android:layout_marginBottom="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    app:layout_constraintBottom_toBottomOf="@id/illustrationContainer"
                    app:layout_constraintStart_toStartOf="@id/illustrationContainer" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ============== WHITE SHEET / FORM ============== -->

            <LinearLayout
                android:id="@+id/authSheet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_sheet_overlap"
                android:background="@drawable/bg_auth_sheet_top"
                android:orientation="vertical"
                android:paddingStart="@dimen/auth_horizontal_margin"
                android:paddingTop="@dimen/auth_sheet_top_padding"
                android:paddingEnd="@dimen/auth_horizontal_margin"
                android:paddingBottom="@dimen/auth_bottom_padding"
                app:layout_constraintVertical_bias="0.3"
                app:layout_constraintTop_toBottomOf="@id/heroSection"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Email -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailInputLayout"
                    style="@style/Widget.PdfStudio.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/email_label"
                    app:boxBackgroundMode="outline"
                    app:expandedHintEnabled="false"
                    app:placeholderTextColor="#a6a6a6"
                    app:placeholderText="@string/email_placeholder"
                    app:startIconContentDescription="@string/email_address"
                    app:startIconDrawable="@drawable/ic_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/black"
                        android:maxLines="1"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordInputLayout"
                    style="@style/Widget.PdfStudio.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_field_spacing"
                    android:hint="@string/password_label"
                    app:boxBackgroundMode="outline"
                    app:endIconMode="password_toggle"
                    app:expandedHintEnabled="false"
                    app:placeholderTextColor="#a6a6a6"
                    app:placeholderText="@string/password_placeholder"
                    app:startIconContentDescription="@string/password"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Forgot password -->

                <TextView
                    android:id="@+id/forgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/auth_small_spacing"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans"
                    android:padding="@dimen/auth_click_padding"
                    android:text="@string/forgot_password_prompt"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Log In button -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginButton"
                    style="@style/Widget.PdfStudio.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_button_height"
                    android:layout_marginTop="@dimen/auth_button_spacing"
                    android:text="@string/action_log_in"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:iconTint="@color/white"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textEnd"
                    app:iconPadding="12dp" />

                <!-- Divider -->

                <LinearLayout
                    android:id="@+id/loginDivider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_section_spacing"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/colorBorder" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:text="@string/divider_continue_with"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/colorBorder" />

                </LinearLayout>

                <!-- Google / Apple -->

                <LinearLayout
                    android:id="@+id/socialButtonsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_section_spacing"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/googleButton"
                        style="@style/Widget.PdfStudio.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/auth_button_height"
                        android:layout_marginEnd="@dimen/auth_social_button_spacing"
                        android:layout_weight="1"
                        android:text="@string/google"
                        android:textAllCaps="false"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        app:icon="@drawable/ic_google"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/appleButton"
                        style="@style/Widget.PdfStudio.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/auth_button_height"
                        android:layout_weight="1"
                        android:text="@string/apple"
                        android:textAllCaps="false"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        app:icon="@drawable/ic_apple"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@null" />

                </LinearLayout>

                <!-- Sign up prompt -->

                <LinearLayout
                    android:id="@+id/signupPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/auth_bottom_section_spacing"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dont_have_account"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/signUpLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="@dimen/auth_click_padding"
                        android:text="@string/link_sign_up"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/loader_layout"
        layout="@layout/loader_layout_pulse"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:elevation="@dimen/margin_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
