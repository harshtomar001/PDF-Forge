<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:focusable="false"
    android:clickable="false"
    android:layout_height="match_parent">

    <include
        android:id="@+id/titleLayout"
        layout="@layout/create_pdf_title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/upload_Layout"
        app:layout_constraintEnd_toEndOf="parent"/>

    <include
        layout="@layout/pptx_pdf_buttons"
        android:id="@+id/upload_Layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="@dimen/margin_60dp"
        android:background="@drawable/dashed_border_1"
        android:layout_marginTop="@dimen/margin_12dp"
        android:layout_marginBottom="@dimen/margin_12dp"
        app:layout_constraintTop_toBottomOf="@id/titleLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/no_ppt_selected"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/no_ppt_selected"
        app:layout_constraintTop_toBottomOf="@id/upload_Layout"
        app:layout_constraintBottom_toTopOf="@id/bottom_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_15dp"
        android:layout_marginBottom="@dimen/margin_15dp"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="38dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/white"
        android:layout_margin="@dimen/margin_18dp"
        app:layout_constraintTop_toBottomOf="@id/upload_Layout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/margin_12dp"
            android:layout_marginBottom="@dimen/margin_12dp"
            android:layout_marginEnd="@dimen/margin_12dp"
            android:layout_marginStart="@dimen/margin_12dp"
            android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/pptPreview"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ppt_icon_200dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/pptName"
            />

            <TextView
                android:id="@+id/pptName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="presentation.pptx"
                android:textColor="@color/black"
                android:textSize="@dimen/margin_15dp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="@dimen/margin_8dp"
                android:layout_marginEnd="@dimen/margin_20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/pptPreview" />

            <TextView
                android:id="@+id/pptSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5.56 MB"
                android:textColor="@color/black"
                android:alpha="0.7"
                android:layout_marginStart="@dimen/margin_8dp"
                android:textSize="@dimen/margin_12dp"
                android:layout_marginTop="@dimen/margin_5dp"
                app:layout_constraintTop_toBottomOf="@id/pptName"
                app:layout_constraintStart_toEndOf="@id/pptPreview"
                />

            <ImageView
                android:id="@+id/dot_break"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/dot_selector"
                app:layout_constraintTop_toTopOf="@id/pptSlides"
                app:layout_constraintBottom_toBottomOf="@+id/pptSlides"
                app:layout_constraintStart_toEndOf="@id/pptSize"
                android:layout_marginStart="@dimen/margin_5dp"
                android:layout_marginEnd="@dimen/margin_5dp"
                />

            <TextView
                android:id="@+id/pptSlides"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14 Slides"
                android:textColor="@color/black"
                android:alpha="0.7"
                android:layout_marginTop="@dimen/margin_5dp"
                android:layout_marginStart="@dimen/margin_5dp"
                android:textSize="@dimen/margin_12dp"
                app:layout_constraintTop_toBottomOf="@id/pptName"
                app:layout_constraintStart_toEndOf="@id/dot_break"
                 />


            <ImageView
                android:id="@+id/remove_ppt"
                android:layout_width="@dimen/margin_30dp"
                android:layout_height="@dimen/margin_30dp"
                app:srcCompat="@drawable/cross_icon_orange"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="@dimen/margin_5dp"
                android:layout_marginEnd="@dimen/margin_5dp"

                />





        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/ready_to_convrt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:src="@drawable/ready_to_convert"
        app:layout_constraintTop_toBottomOf="@id/card_layout"
        app:layout_constraintBottom_toTopOf="@id/bottom_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0"
        android:layout_marginTop="@dimen/margin_15dp"
        android:layout_marginBottom="@dimen/margin_15dp" />

    <include
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:id="@+id/bottom_section"
        layout="@layout/create_pdf_shield_layout"
        android:layout_marginLeft="@dimen/margin_18dp"
        android:layout_marginRight="@dimen/margin_18dp"
        android:layout_marginBottom="@dimen/margin_10dp"
        android:layout_marginTop="@dimen/margin_5dp"
        app:layout_constraintBottom_toTopOf="@+id/convert_to_pdf"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/convert_to_pdf"
        android:padding="@dimen/margin_8dp"
        android:background="@drawable/convert_to_pdf_bg"
        android:layout_marginLeft="@dimen/margin_18dp"
        android:layout_marginRight="@dimen/margin_18dp"
        android:layout_marginBottom="@dimen/margin_18dp"
        android:layout_marginTop="@dimen/margin_5dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/pdf_icon_doc_ppt_pdf"
            android:layout_width="@dimen/margin_50dp"
            android:layout_height="@dimen/margin_50dp"
            android:src="@drawable/pdf_icon_android"
            android:layout_marginLeft="@dimen/margin_12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Convert to PDF"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Convert PPT files to PDF"
                android:textColor="@color/white"
                android:id="@+id/convrt_to_pdf_text"
                android:alpha="0.9"
                android:textSize="12sp"
                android:textStyle="normal"
                />





        </LinearLayout>



    </LinearLayout>


    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/noInternetLayout"
        layout="@layout/no_internet"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <include
        android:id="@+id/loading_bar"
        layout="@layout/loading_bar"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>