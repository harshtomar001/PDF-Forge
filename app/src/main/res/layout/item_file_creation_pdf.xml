<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_border"
    android:layout_marginLeft="14dp"
    android:layout_marginRight="14dp">

    <ImageView
        android:id="@+id/pdf_iicon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:srcCompat="@drawable/pdf_fevicon"
        android:layout_gravity="center_vertical"/>




    <LinearLayout

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        android:layout_marginLeft="12dp"
        >


        <TextView
            android:id="@+id/file_name_creation_pdfs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/filename"
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="@color/black"

        />

        <TextView
            android:id="@+id/file_size_creation_pdfs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/grey"
            android:text="@string/fileSize"
            android:layout_marginLeft="10dp"
        />

        <TextView
            android:id="@+id/file_pages_creation_pdfs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pagesCount"
            android:textColor="@color/grey"
            android:layout_marginLeft="10dp"

        />


    </LinearLayout>

    <ImageView
        android:id="@+id/download_creation_pdfs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/download_icon"
        android:layout_gravity="center_vertical"/>
    <ImageView
        android:id="@+id/delete_creation_pdfs"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="@dimen/margin_5dp"
        app:srcCompat="@drawable/delete"
        android:layout_gravity="center_vertical"/>







</LinearLayout>