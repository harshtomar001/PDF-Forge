<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@android:color/transparent"
    android:layout_height="wrap_content">


    <LinearLayout
        android:id="@+id/total_page_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_10dp"
        android:paddingTop="@dimen/margin_10dp"
        android:background="@drawable/rounder_border_edit_pdf"
        android:paddingBottom="@dimen/margin_15dp"
        android:layout_marginTop="@dimen/margin_5dp"
        android:layout_marginHorizontal="@dimen/margin_8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <ImageView

            android:layout_width="30dp"
            android:layout_height="30dp"
            app:srcCompat="@drawable/blue_tick" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"

            android:layout_marginStart="@dimen/margin_18dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/total_pages_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="@dimen/margin_15dp"
                android:textStyle="bold"
                android:text="4 Pages Selected" />
            <TextView
                android:id="@+id/page_no_textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/darkGray"
                android:textStyle="italic"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="@dimen/margin_12dp"
                android:fontFamily="@font/iosevka_charonmono_mediumitalic"
                android:text="2,4,6,8,19" />




        </LinearLayout>

        <TextView
            android:id="@+id/clearSelectedPages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear"
            android:textSize="@dimen/margin_15dp"
            android:paddingStart="@dimen/margin_8dp"
            android:paddingEnd="@dimen/margin_8dp"
            android:paddingTop="@dimen/margin_5dp"
            android:paddingBottom="@dimen/margin_5dp"
            android:textStyle="bold"
            android:textColor="@color/purple_"
            />


    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/parent_of_save_pdf_tools_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        app:strokeWidth="0dp"
        app:cardElevation="13dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginBottom="@dimen/margin_10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/total_page_layout">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@android:color/transparent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addImageBtn"
                    android:visibility="gone"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="@dimen/margin_15dp"
                    android:layout_marginBottom="@dimen/margin_15dp"
                    app:backgroundTint="@null"
                    android:backgroundTint="@null"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/purple"
                    android:background="@drawable/add_img_bg"
                    android:text="Add Images"
                    android:textColor=" #2563EB"
                    app:iconTint="#2563EB"
                    app:icon="@drawable/add_btn"
                    app:iconSize="@dimen/margin_30dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="@dimen/margin_12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                   app:layout_constraintBottom_toTopOf="@id/saveChangesBtn" />


                <LinearLayout
                    android:id="@+id/toolsRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginHorizontal="@dimen/margin_15dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/saveChangesBtn"
                    android:layout_marginBottom="@dimen/margin_5dp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:padding="@dimen/margin_10dp"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:id="@+id/edit_text"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/margin_10dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/edit_text_icon_1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edit Text"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/darkGray"
                            android:textSize="13dp"
                            />
                    </LinearLayout>


                    <View
                        android:layout_width="1dp"
                        android:layout_height="50dp"
                        android:background="@color/darkGray"
                        android:alpha=".3" />

                    <LinearLayout
                        android:id="@+id/delete_pages"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:padding="@dimen/margin_10dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/delete_tray_red" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delete"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/darkGray"
                            android:textSize="13dp"
                            />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="50dp"
                        android:background="@color/darkGray"
                        android:alpha=".3" />

                    <LinearLayout
                        android:id="@+id/waterMark"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/margin_10dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/watermark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Watermark"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/darkGray"
                            android:textSize="13dp"
                            />
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/extract_pages"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/margin_10dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/extract_icon"
                            android:tint="#1074e6" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Extract"
                            android:textColor="@color/darkGray"
                            android:textSize="13dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="50dp"
                        android:background="@color/darkGray"
                        android:alpha=".3" />

                    <LinearLayout
                        android:id="@+id/moreOption"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/margin_10dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/three_dot_horizontal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Options"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/darkGray"
                            android:textSize="13dp"
                            />
                    </LinearLayout>

                </LinearLayout>


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveChangesBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Save Changes"
                    android:textAllCaps="false"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingVertical="@dimen/margin_8dp"
                    android:textColor="@android:color/white"
                    app:icon="@drawable/ic_save"
                    app:iconTint="@android:color/white"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconSize="@dimen/margin_30dp"
                    app:cornerRadius="12dp"
                    android:background="@drawable/bg_save_changes_btn"
                    app:backgroundTint="@null"
                    android:layout_marginBottom="@dimen/margin_10dp"
                    android:layout_marginTop="@dimen/margin_18dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />


            </androidx.constraintlayout.widget.ConstraintLayout>


        </LinearLayout>



    </com.google.android.material.card.MaterialCardView>



</androidx.constraintlayout.widget.ConstraintLayout>