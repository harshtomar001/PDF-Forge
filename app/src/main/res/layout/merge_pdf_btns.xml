<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="@dimen/margin_20dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <LinearLayout
        android:layout_width="match_parent"
        android:background="@color/white"
        android:padding="4dp"
        android:gravity="center"
        android:layout_height="match_parent" >

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:background="@drawable/upl_pdf_mp_bg"
        android:layout_gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible"
        android:layout_marginRight="3dp"
        android:paddingTop="@dimen/margin_8dp"
        android:paddingRight="@dimen/margin_5dp"
        android:paddingLeft="@dimen/margin_5dp"
        android:paddingBottom="@dimen/margin_8dp"
        android:id="@+id/upload_Layout">

    <ImageView
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:src="@drawable/cloud_upload_icon_short"
        android:layout_gravity="center"
        android:clickable="false"
        android:focusable="false"
        android:layout_marginLeft="-28dp"
        android:duplicateParentState="true"
        />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clickable="false"
        android:focusable="false"
        android:layout_marginStart="-25dp"
        android:layout_marginEnd="@dimen/margin_12dp"
        android:orientation="vertical">



        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="@string/upload_pdfs"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/white"
            android:textStyle="bold"
            />

        <TextView
            android:layout_marginTop="2dp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/add_PDFs_from_Device"
            android:textSize="9sp"
            android:textColor="@color/white"
            android:alpha="0.8"

            />




    </LinearLayout>




    </LinearLayout>




    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/mrg_pdf_bg_mp"
        android:layout_gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:paddingTop="@dimen/margin_8dp"
        android:paddingEnd="@dimen/margin_8dp"
        android:paddingStart="@dimen/margin_10dp"
        android:paddingBottom="@dimen/margin_8dp"
        android:id="@+id/pdf_information_mp">




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/margin_8dp"
            android:orientation="vertical">



            <TextView
                android:id="@+id/n_pdfs_selected"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/merge_pdf"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textColor="#E8192C"
                android:textStyle="bold"
                />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                    <ImageView
                        android:layout_height="@dimen/margin_15dp"
                        android:layout_width="@dimen/margin_15dp"
                        android:src="@drawable/folder"
                        android:alpha=".7"
                        />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:text="2.45 MB"
                        android:id="@+id/pdfSize"
                        android:alpha="0.7"
                        android:textSize="8sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:backgroundTint="@null"
                        android:paddingLeft="@dimen/margin_8dp"

                        />


                    <ImageView
                        android:layout_height="@dimen/margin_15dp"
                        android:layout_width="@dimen/margin_15dp"
                        android:src="@drawable/fullstop"
                        android:alpha=".7"
                        />

                    <ImageView
                        android:layout_height="@dimen/margin_15dp"
                        android:layout_width="@dimen/margin_15dp"
                        android:src="@drawable/blankpage"
                        android:alpha=".7"
                        />


                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:text="8 pages"
                        android:id="@+id/pdfPages"
                        android:alpha="0.7"
                        android:textSize="8sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:backgroundTint="@null"
                        android:paddingLeft="@dimen/margin_8dp"

                        />



                </LinearLayout>


        </LinearLayout>
    </LinearLayout>



    </LinearLayout>

</com.google.android.material.card.MaterialCardView>



