<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/parent_layout_split_pdf"
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <include
        android:id="@+id/split_toolbar"
        layout="@layout/split_pdf_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/split_toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/all_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:orientation="vertical">

            <LinearLayout
                android:id="@+id/uploadPdfLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_margin="@dimen/margin_20dp"
                android:background="@drawable/bg_upload_pdf_card"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_upload_pdf"
                     />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Upload PDF"
                    android:textColor="#171717"
                    android:textSize="18dp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Choose a PDF file to split"
                    android:textColor="#777A85"
                    android:textSize="14dp" />

            </LinearLayout>

            <!-- PDF Selected Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pdf_preview_card_split_pdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                android:layout_margin="@dimen/margin_18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingBottom="@dimen/margin_8dp"
                    android:paddingTop="@dimen/margin_12dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/pdf_icon_split_pdf"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/ic_pdf_file"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        />

                    <LinearLayout
                        android:id="@+id/pdf_data"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical"
                        app:layout_constraintTop_toTopOf="@+id/pdf_icon_split_pdf"
                        app:layout_constraintBottom_toBottomOf="@id/pdf_icon_split_pdf"
                        app:layout_constraintStart_toEndOf="@id/pdf_icon_split_pdf"
                        app:layout_constraintEnd_toStartOf="@+id/remove_pdf_split_pdf"

                        >

                        <TextView
                            android:id="@+id/pdfName_split_pdf"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Project_Proposal.pdf"
                            android:textColor="#171717"
                            android:textSize="15dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/pdfMetadata_split_pdf"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="24.6 MB  •  32 pages"
                            android:textColor="#777A85"
                            android:textSize="14sp"/>



                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/tapToPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:background="@drawable/tap_to_preview_bg"
                        android:paddingStart="@dimen/margin_10dp"
                        android:paddingBottom="@dimen/margin_5dp"
                        android:paddingTop="@dimen/margin_5dp"
                        android:paddingEnd="@dimen/margin_8dp"
                        android:layout_marginStart="@dimen/margin_30dp"
                        android:layout_marginTop="@dimen/margin_12dp"
                        app:layout_constraintTop_toBottomOf="@id/pdf_data"
                        app:layout_constraintStart_toEndOf="@id/pdf_icon_split_pdf">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to preview"
                        android:textSize="@dimen/margin_12dp"
                        android:textColor="#1bb549" />

                        <ImageView
                            android:id="@+id/rightArrow"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginStart="2dp"
                            android:layout_gravity="center"
                            android:tint="#1bb549"
                            android:layout_marginTop="1dp"
                            android:src="@drawable/right_arrow"
                            app:layout_constraintBottom_toBottomOf="@id/txtPreview"
                            app:layout_constraintStart_toEndOf="@id/txtPreview"
                            app:layout_constraintTop_toTopOf="@id/txtPreview"/>

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/remove_pdf_split_pdf"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_light"
                        android:padding="9dp"
                        android:src="@drawable/cross_sign"
                        app:layout_constraintEnd_toEndOf="parent"

                        android:layout_marginEnd="2dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#555555"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/choose_split_method_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_split_method"
                android:textColor="#151515"
                android:textSize="15dp"
                android:textStyle="bold"
                android:layout_margin="@dimen/margin_18dp"/>

            <!-- Split method -->
            <LinearLayout
                android:id="@+id/split_card"
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:gravity="center"
                android:paddingTop="@dimen/margin_8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/extractRangeCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/margin_18dp"
                    android:paddingStart="@dimen/margin_8dp"
                    android:paddingEnd="@dimen/margin_8dp"
                    android:background="@drawable/bg_selected_split_card">

                    <ImageView
                        android:id="@+id/extractRange_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_page_range"
                        app:tint="#D84072"/>

                    <TextView
                        android:id="@+id/extract_range_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Extract page range"
                        android:textColor="#D84072"
                        android:textSize="15dp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/individualPagesCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:gravity="center"
                    android:layout_marginEnd="@dimen/margin_18dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_unselected_split_card">

                    <ImageView
                        android:id="@+id/individualPagesCardIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_individual_split_pdf"
                        app:tint="#555555"/>

                    <TextView
                        android:id="@+id/individualPagesCardText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Split into individual pages"
                        android:textColor="#222222"
                        android:textSize="15dp"
                        android:textAlignment="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/selectMorePage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select page range"
                android:textColor="#151515"
                android:textSize="15dp"
                android:layout_marginStart="@dimen/margin_18dp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>

            <!-- Page Range Card -->
            <LinearLayout
                android:id="@+id/pageRangeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="18dp"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/margin_18dp"
                android:layout_marginEnd="@dimen/margin_18dp"
                android:background="@drawable/bg_normal_card">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/margin_8dp"
                    >

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="From"
                        android:alpha="0.6"
                        android:textSize="@dimen/margin_12dp"
                        android:textColor="@color/black"
                        android:layout_marginEnd="@dimen/margin_20dp"
                        android:paddingStart="@dimen/margin_8dp"
                        />

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="To"
                        android:paddingStart="@dimen/margin_8dp"
                        android:alpha="0.6"
                        android:textSize="@dimen/margin_12dp"
                        android:textColor="@color/black"
                        android:layout_marginStart="@dimen/margin_20dp"
                        />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/fromPageEt"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_box"
                        android:hint="From"
                        android:inputType="number"
                        android:text="1"
                        android:textColor="#111111"
                        android:textSize="18sp"
                        android:paddingStart="16dp"/>

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:textColor="#444444"/>

                    <EditText
                        android:id="@+id/toPageEt"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_box"
                        android:hint="To"
                        android:inputType="number"
                        android:text="10"
                        android:textColor="#111111"
                        android:textSize="18sp"
                        android:paddingStart="16dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/pageCountTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total 10 pages will be extracted"
                    android:textColor="#777A85"
                    android:textSize="15sp"
                    android:layout_marginTop="18dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/pagePreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Page preview"
                android:textColor="#151515"
                android:textSize="15dp"
                android:layout_marginStart="@dimen/margin_18dp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pages_preview_recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="@dimen/margin_10dp"
                android:paddingEnd="@dimen/margin_10dp"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/margin_12dp"/>


            <!-- Quick select -->
            <LinearLayout
                android:id="@+id/quickLayout"
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="16dp"
                android:padding="18dp"
                android:layout_marginStart="@dimen/margin_18dp"
                android:layout_marginEnd="@dimen/margin_18dp"
                android:orientation="vertical"
                android:background="@drawable/bg_normal_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quick select"
                        android:textSize="16sp"
                        android:textColor="#222222"/>

                    <TextView
                        android:id="@+id/rangeTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 – 10 of 32"
                        android:textSize="14sp"
                        android:textColor="#777A85"/>
                </LinearLayout>

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/rangeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1"
                    android:valueTo="32"
                    android:stepSize="1"
                    app:tickVisible="false"
                    app:values="@array/default_range"
                    app:trackColorActive="#D84072"
                    app:trackColorInactive="#F3B3C8"
                    app:thumbColor="#FFFFFF"
                    app:haloColor="#22D84072"/>


            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/splitPdfBtn"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="20dp"
                android:text="Split PDF"
                android:textColor="@android:color/white"
                android:textSize="18dp"
                android:layout_marginStart="@dimen/margin_18dp"
                android:layout_marginEnd="@dimen/margin_18dp"
                android:textStyle="bold"
                app:icon="@drawable/split_pdf_logo"
                app:iconGravity="textStart"
                app:iconSize="@dimen/margin_25dp"
                app:iconTint="@color/white"
                app:backgroundTint="@null"
                android:background="@drawable/bg_split_button"/>

            </LinearLayout>

            <ImageView
                android:id="@+id/no_pdf_selected_split_pdf"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:visibility="gone"
                android:scaleType="fitCenter"
                android:src="@drawable/no_pdf_selected_split_pdf"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/all_content"

                />






        </androidx.constraintlayout.widget.ConstraintLayout>



    </ScrollView>

    <FrameLayout
        android:id="@+id/floatingEditBoxFrameLayout"
        android:visibility="gone"
        android:layout_gravity="bottom"
        android:elevation="@dimen/margin_60dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <EditText
            android:id="@+id/floatingEditTextBox"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_50dp"
            android:inputType="number"
            android:cursorVisible="true"
            android:textCursorDrawable="@color/black"
            android:hapticFeedbackEnabled="true"
            android:textColorHint="@color/grey"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:padding="12dp"
            android:elevation="10dp"
            android:background="#FAE4E4" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>