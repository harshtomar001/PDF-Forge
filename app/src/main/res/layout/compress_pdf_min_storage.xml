<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView android:id="@+id/cardMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="20dp"
    android:layout_marginStart="@dimen/margin_20dp"
    android:layout_marginEnd="@dimen/margin_20dp"
    app:strokeWidth="0dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0F9F0"
            android:padding="8dp">

            <!-- Storage Icon Circle -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/iconContainer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_light_green"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/ivStorageIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_storage_check"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <View
                    android:id="@+id/dotOrange"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_circle_orange"
                    tools:layout_editor_absoluteX="3dp"
                    tools:layout_editor_absoluteY="2dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Decorative dots -->

            <View
                android:id="@+id/dotBlue"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_blut"
                app:layout_constraintTop_toTopOf="@id/tvTitle"
                app:layout_constraintStart_toEndOf="@id/iconContainer"
                />

            <View
                android:id="@+id/dotGreenSmall"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_green"
                app:layout_constraintBottom_toBottomOf="@id/iconContainer"
                app:layout_constraintStart_toEndOf="@id/iconContainer"
                android:layout_marginStart="0dp"
                android:layout_marginBottom="4dp"/>

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Storage Saved"
                android:textColor="#1B5E20"
                android:textSize="18dp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="@id/iconContainer"
                app:layout_constraintStart_toEndOf="@id/iconContainer"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="The original file was small, so the total storage saved is limited."
                android:textColor="#4B5563"
                android:textSize="13dp"
                android:lineSpacingExtra="3dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toEndOf="@id/iconContainer"
                app:layout_constraintEnd_toEndOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


