<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/no_internet_layout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:elevation="200dp"
    android:background="@drawable/no_internet_bg"
    android:paddingBottom="24dp"
    android:paddingStart="@dimen/margin_24dp">

    <ImageView
        android:id="@+id/removeImage"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="2dp"
        android:layout_marginTop="1dp"
        android:contentDescription="@string/no_internet"
        android:src="@drawable/cross_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />


    <ImageView
        android:id="@+id/noInternetImage"
        android:layout_width="120dp"
        android:layout_height="100dp"
        android:src="@drawable/wifi_lightning_1"
        android:contentDescription="@string/no_internet"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/noInternetTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/margin_24dp"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/noInternetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_internet_connection"
        android:textColor="@color/white"
        android:textSize="22dp"
        android:textStyle="bold"
        android:paddingEnd="@dimen/margin_24dp"
        app:layout_constraintTop_toBottomOf="@id/noInternetImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="SpUsage" />

    <TextView
        android:id="@+id/noInternetMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/please_check_your_connection_and_try_again"
        android:textColor="@color/white"
        android:textSize="15dp"
        android:alpha="0.6"
        android:layout_marginEnd="@dimen/margin_30dp"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/noInternetTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="SpUsage" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/retryButton"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="@string/retry"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="28dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="48dp"
        app:cornerRadius="16dp"
        app:backgroundTint="#E8531A"
        app:rippleColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/noInternetMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Remove Retry Button and add this -->

    <ProgressBar
        android:id="@+id/checkingProgress"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:visibility="gone"
        android:layout_marginTop="28dp"
        android:indeterminate="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="48dp"
        android:indeterminateTint="@color/white"
        app:layout_constraintTop_toBottomOf="@id/noInternetMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/checkingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Checking connection..."
        android:textColor="@color/white"
        android:textSize="15sp"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/checkingProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>