<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/title_edit_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#3D7BEF"
    android:paddingLeft="@dimen/margin_8dp"
    android:paddingRight="@dimen/margin_8dp"
    android:paddingTop="@dimen/margin_20dp"
    android:orientation="horizontal"
    android:textAlignment="center">

    <ImageView
        android:id="@+id/back_arrow_edit_image"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:clickable="true"
        android:layout_gravity="center_vertical"
        android:contentDescription="@string/todo"
        android:focusable="true"
        android:padding="10dp"
        app:srcCompat="@drawable/ic_back_arrow"
        />

    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/margin_5dp"
        android:layout_marginLeft="@dimen/margin_5dp"
        >

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/convertImage"
        android:textColor="@color/white"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        />


        <TextView
            android:id="@+id/subtitle_fetch_img_pdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_images_text_title"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:alpha="0.7"
            />

    </LinearLayout>

</LinearLayout>