<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/signupScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/auth_bottom_padding"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/signupContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Back -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/heroSection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="@dimen/margin_20dp"
                android:background="@drawable/bg_auth_hero"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:id="@+id/illustrationGlow"
                    android:layout_width="@dimen/auth_illustration_glow_size"
                    android:layout_height="@dimen/auth_illustration_glow_size"
                    android:layout_marginVertical="@dimen/margin_12dp"
                    android:layout_marginEnd="@dimen/margin_8dp"
                    android:background="@drawable/bg_illustration_glow"
                    android:importantForAccessibility="no"
                    app:layout_constraintTop_toTopOf="@id/backButton"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/auth_back_button_size"
                    android:layout_height="@dimen/auth_back_button_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_back_button"
                    android:padding="8dp"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="@color/card_white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Title -->

                <LinearLayout
                    android:id="@+id/titleRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/backButton"
                    app:layout_constraintStart_toStartOf="parent">

                    <TextView
                        android:id="@+id/signupTitleCreate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:text="@string/signup_title_create"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/signupTitleAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:text="@string/signup_title_account"
                        android:textColor="@color/colorBrandYellow"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Subtitle -->

                <TextView
                    android:id="@+id/signupSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_subtitle_spacing"
                    android:includeFontPadding="false"
                    android:text="@string/signup_subtitle_join"
                    android:textColor="@color/colorHeroSubtitleText"
                    android:textSize="15sp"
                    app:layout_constraintTop_toBottomOf="@id/titleRow"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <ImageView
                    android:id="@+id/sparkleTop"
                    android:layout_width="@dimen/auth_sparkle_size_large"
                    android:layout_height="@dimen/auth_sparkle_size_large"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    app:layout_constraintEnd_toEndOf="@id/signupSubtitle"
                    />

                <ImageView
                    android:id="@+id/sparkleMiddle"
                    android:layout_width="@dimen/auth_sparkle_size_small"
                    android:layout_height="@dimen/auth_sparkle_size_small"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    app:layout_constraintStart_toStartOf="@id/illustrationGlow"
                    />

                <ImageView
                    android:id="@+id/sparkleBottom"
                    android:layout_width="@dimen/auth_sparkle_size_small"
                    android:layout_height="@dimen/auth_sparkle_size_small"
                    android:layout_marginBottom="18dp"
                    android:importantForAccessibility="no"
                    android:layout_marginTop="-24dp"
                    android:src="@drawable/ic_sparkle"
                    app:layout_constraintBottom_toBottomOf="@id/illustrationGlow"
                    app:layout_constraintStart_toStartOf="@id/illustrationGlow"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <LinearLayout
                android:id="@+id/signupFormContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_card_top_spacing"
                android:orientation="vertical"
                android:paddingStart="@dimen/margin_24dp"
                android:paddingEnd="@dimen/margin_24dp"
                app:layout_constraintTop_toBottomOf="@id/heroSection"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="0.2"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Full Name -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fullNameInputLayout"
                    style="@style/Widget.PdfStudio.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/full_name_label"
                    app:boxBackgroundMode="outline"
                    app:expandedHintEnabled="false"
                    app:placeholderTextColor="#a6a6a6"
                    app:placeholderText="@string/full_name_placeholder"
                    app:startIconContentDescription="@string/full_name_label"
                    app:startIconDrawable="@drawable/ic_person">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fullNameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="name"
                        android:textColor="@color/black"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailInputLayout"
                    style="@style/Widget.PdfStudio.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_field_spacing"
                    android:hint="@string/email_label"
                    app:boxBackgroundMode="outline"
                    app:expandedHintEnabled="false"
                    app:placeholderTextColor="#a6a6a6"
                    app:placeholderText="@string/email_placeholder"
                    app:startIconContentDescription="@string/email_address"
                    app:startIconDrawable="@drawable/ic_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/black"
                        android:maxLines="1"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordInputLayout"
                    style="@style/Widget.PdfStudio.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_field_spacing"
                    android:hint="@string/password_label"
                    app:boxBackgroundMode="outline"
                    app:endIconMode="password_toggle"
                    app:expandedHintEnabled="false"
                    app:placeholderTextColor="#a6a6a6"
                    app:placeholderText="@string/password_create_placeholder"
                    app:startIconContentDescription="@string/password"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:inputType="textPassword"
                        android:textColor="@color/black"
                        android:maxLines="1"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password strength meter -->

                <LinearLayout
                    android:id="@+id/strengthSegmentsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/strengthSegmentOne"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/auth_strength_segment_height"
                        android:layout_marginEnd="@dimen/auth_strength_segment_spacing"
                        android:layout_weight="1"
                        android:background="@drawable/bg_strength_segment_track" />

                    <View
                        android:id="@+id/strengthSegmentTwo"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/auth_strength_segment_height"
                        android:layout_marginEnd="@dimen/auth_strength_segment_spacing"
                        android:layout_weight="1"
                        android:background="@drawable/bg_strength_segment_track" />

                    <View
                        android:id="@+id/strengthSegmentThree"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/auth_strength_segment_height"
                        android:layout_marginEnd="@dimen/auth_strength_segment_spacing"
                        android:layout_weight="1"
                        android:background="@drawable/bg_strength_segment_track" />

                    <View
                        android:id="@+id/strengthSegmentFour"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/auth_strength_segment_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_strength_segment_track" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/password_strength_label"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/strengthValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="None"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Confirm Password -->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/confirmPasswordInputLayout"
                    style="@style/Widget.PdfStudio.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_field_spacing"
                    android:hint="@string/confirm_password_label"
                    app:boxBackgroundMode="outline"
                    app:endIconMode="password_toggle"
                    app:expandedHintEnabled="false"
                    app:placeholderTextColor="#a6a6a6"
                    app:placeholderText="@string/confirm_password_placeholder"
                    app:startIconContentDescription="@string/confirm_password_label"
                    app:startIconDrawable="@drawable/ic_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/confirmPasswordEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:inputType="textPassword"
                        android:textColor="@color/black"
                        android:maxLines="1"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Terms -->

                <LinearLayout
                    android:id="@+id/termsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_section_spacing"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/termsCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/auth_checkbox_text_spacing"
                        android:buttonTint="@color/colorPrimary"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp" />

                    <TextView
                        android:id="@+id/termsText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/agree_to_terms"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Sign Up button -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signUpButton"
                    style="@style/Widget.PdfStudio.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_button_height"
                    android:layout_marginTop="@dimen/auth_button_spacing"
                    android:text="@string/action_sign_up"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:iconTint="@color/white"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textEnd"
                    app:iconPadding="12dp" />

                <!-- Divider -->

                <LinearLayout
                    android:id="@+id/signupDivider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_section_spacing"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/colorBorder" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:text="@string/divider_sign_up_with"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/colorBorder" />

                </LinearLayout>

                <!-- Google / Apple -->

                <LinearLayout
                    android:id="@+id/socialButtonsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_section_spacing"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/googleButton"
                        style="@style/Widget.PdfStudio.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/auth_button_height"
                        android:layout_marginEnd="@dimen/auth_social_button_spacing"
                        android:layout_weight="1"
                        android:text="@string/google"
                        android:textAllCaps="false"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        app:icon="@drawable/ic_google"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/appleButton"
                        style="@style/Widget.PdfStudio.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/auth_button_height"
                        android:layout_weight="1"
                        android:text="@string/apple"
                        android:textAllCaps="false"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="15sp"
                        app:icon="@drawable/ic_apple"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@null" />

                </LinearLayout>

                <!-- Login prompt -->

                <LinearLayout
                    android:id="@+id/loginPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/auth_bottom_section_spacing"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/already_have_account"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/loginLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="@dimen/auth_click_padding"
                        android:text="@string/link_log_in"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>



        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/loader_layout"
        layout="@layout/loader_layout_pulse"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:elevation="@dimen/margin_20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
