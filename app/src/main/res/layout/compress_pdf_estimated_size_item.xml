<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            tools:ignore="UseCompoundDrawables">


            <ImageView
                android:id="@+id/ivBarChart"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/bar_chart"
                android:contentDescription="Bar chart icon"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Estimated Result"
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                tools:ignore="HardcodedText,SpUsage" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCurrentSizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Size"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12dp"
                    android:textColor="@color/color_text_secondary"
                    android:layout_marginBottom="4dp"
                    tools:ignore="HardcodedText,SpUsage" />


                <TextView
                    android:id="@+id/tvCurrentSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="253.22 MB"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_error"
                    tools:ignore="HardcodedText,SpUsage" />

            </LinearLayout>



            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:background="@color/color_divider"/>



            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvEstimatedSizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated Size"
                    android:textSize="12dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/color_text_secondary"
                    android:layout_marginBottom="4dp"
                    tools:ignore="HardcodedText,SpUsage" />

                <TextView
                    android:id="@+id/tvEstimatedSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~ 190 MB"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_error"
                    tools:ignore="HardcodedText,SpUsage" />
            </LinearLayout>


            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:background="@color/color_divider"/>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvSizeReductionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Size Reduction"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12dp"
                    android:textColor="@color/color_text_secondary"
                    android:layout_marginBottom="4dp"
                    tools:ignore="HardcodedText,SpUsage" />


                <TextView
                    android:id="@+id/tvSizeReduction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~ 25%"
                    android:textSize="18dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:textColor="@color/color_error"
                    tools:ignore="HardcodedText,SpUsage" />

            </LinearLayout>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBarCompression"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="25"
            android:progressDrawable="@drawable/progress_bar_red"
            android:background="@null"/>


    </LinearLayout>

</androidx.cardview.widget.CardView>