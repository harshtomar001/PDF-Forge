<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">



    <FrameLayout
        android:id="@+id/rotatePDF_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/margin_18dp"
        android:background="@drawable/toolbar_bg_rotp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        >

        <ImageView

            android:id="@+id/back_arrow_rotate_pdf"
            android:layout_width="@dimen/margin_40dp"
            android:layout_height="@dimen/margin_40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="-5dp"
            app:srcCompat="@drawable/ic_back_arrow" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_50dp"
            >

            <TextView
                android:id="@+id/page_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotatePDF"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/title_page_text_toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotate_pdf_title_text"
                android:textSize="@dimen/margin_10dp"
                android:alpha="0.7"
                android:textColor="@color/white"/>

        </LinearLayout>
        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="@dimen/margin_60dp"
            android:layout_height="@dimen/margin_60dp"
            android:alpha="0.4"
            android:layout_gravity="right"
            app:srcCompat="@drawable/reverse_pdf_icon_fixed" />
        <ImageView

            android:layout_width="@dimen/margin_60dp"
            android:layout_height="@dimen/margin_60dp"
            android:alpha="0.2"
            android:layout_gravity="center|bottom"
            app:srcCompat="@drawable/reverse_pdf_icon_fixed" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/margin_18dp"
        android:padding="@dimen/margin_5dp"
        app:layout_constraintTop_toBottomOf="@id/rotatePDF_toolbar">

        <LinearLayout
            android:id="@+id/rotate_pdf_upload_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/btn_bg_rotp"
            android:padding="@dimen/margin_8dp">

            <ImageView
                android:layout_gravity="center"

                android:layout_width="@dimen/margin_50dp"
                android:layout_height="@dimen/margin_50dp"
                android:layout_marginBottom="-5dp"
                app:srcCompat="@drawable/upload_pdf_icon_purple_1" />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginRight="@dimen/margin_15dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_pdf"
                    android:textColor="#4A1F8C"
                    android:textStyle="bold"
                    android:textSize="@dimen/margin_15dp"
                    android:layout_marginBottom="3dp"/>

                <TextView
                    android:id="@+id/text_below_upl_pdf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rotatePagesPDF"
                    android:textSize="@dimen/margin_12dp"
                    android:alpha="0.6"
                    android:textColor="@color/black"
                    />


            </LinearLayout>


        </LinearLayout>

    </LinearLayout>



</LinearLayout>