<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">



    <LinearLayout
        android:id="@+id/info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/preview_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_after_rotation_90"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_weight="1"/>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_0_degree"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="64dp"
                android:text="0°"
                android:textStyle="bold"
                app:cornerRadius="6dp"
                app:strokeWidth="2dp"
                app:strokeColor="#63487C"
                app:icon="@drawable/rotate_0"
                app:iconPadding="4dp"
                app:iconGravity="textStart"
                app:backgroundTint="@color/white"
                android:textColor="@color/black"
                app:iconTint="@color/black"
                android:layout_marginEnd="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_90_degree"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="64dp"
                android:text="@string/_90"
                android:textStyle="bold"
                app:cornerRadius="6dp"
                app:strokeWidth="2dp"
                app:strokeColor="#63487C"
                app:icon="@drawable/rotate_0"
                app:iconPadding="4dp"
                app:iconGravity="textStart"
                app:backgroundTint="@color/white"
                android:textColor="@color/black"
                app:iconTint="@color/black"/>
        </LinearLayout>

    </LinearLayout>



    <TextView
        android:id="@+id/total_pages_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Showing 5 out of 20 pages"
        android:textColor="@color/black"
        android:alpha="0.6"
        android:textSize="13sp"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/info"
        app:layout_constraintStart_toStartOf="parent"/>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rotate_pdf_recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toBottomOf="@id/total_pages_preview"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>