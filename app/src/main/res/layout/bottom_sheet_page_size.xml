                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:buttonTint="@color/rgb_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_letter_label"
                    android:textColor="@color/pdf_studio_dark_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_letter_desc"
                    android:textColor="@color/pdf_studio_secondary_gray"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Legal -->

        <LinearLayout
            android:id="@+id/rowLegal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_merge_page_size_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_sm">

            <RadioButton
                android:id="@+id/radioLegal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:buttonTint="@color/rgb_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_legal_label"
                    android:textColor="@color/pdf_studio_dark_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_legal_desc"
                    android:textColor="@color/pdf_studio_secondary_gray"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>