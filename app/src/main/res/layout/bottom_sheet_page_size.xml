<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pdf_studio_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/pdf_studio_divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/merge_page_size_sheet_title"
            android:textColor="@color/pdf_studio_dark_navy"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- ========================= -->
        <!-- Original -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/rowOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_merge_page_size_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_sm">

            <RadioButton
                android:id="@+id/radioOriginal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:clickable="false"
                android:buttonTint="@color/rgb_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_original_label"
                    android:textColor="@color/pdf_studio_dark_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_original_desc"
                    android:textColor="@color/pdf_studio_secondary_gray"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================= -->
        <!-- FIT TO SMALLEST -->
        <!-- ========================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Fit to smallest"
            android:textColor="@color/pdf_studio_secondary_gray"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!-- Smallest Width -->

        <LinearLayout
            android:id="@+id/rowFitSmallestWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_merge_page_size_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_sm">

            <RadioButton
                android:id="@+id/radioFitSmallestWidth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:buttonTint="@color/rgb_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_fit_smallest_width_label"
                    android:textColor="@color/pdf_studio_dark_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_fit_smallest_width_desc"
                    android:textColor="@color/pdf_studio_secondary_gray"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Smallest Height -->

        <LinearLayout
            android:id="@+id/rowFitSmallestHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_merge_page_size_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_sm">

            <RadioButton
                android:id="@+id/radioFitSmallestHeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:buttonTint="@color/rgb_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_fit_smallest_height_label"
                    android:textColor="@color/pdf_studio_dark_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_fit_smallest_height_desc"
                    android:textColor="@color/pdf_studio_secondary_gray"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Smallest Both -->

        <LinearLayout
            android:id="@+id/rowFitSmallestBoth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_merge_page_size_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_sm">

            <RadioButton
                android:id="@+id/radioFitSmallestBoth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:buttonTint="@color/rgb_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_fit_smallest_label"
                    android:textColor="@color/pdf_studio_dark_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_fit_smallest_desc"
                    android:textColor="@color/pdf_studio_secondary_gray"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================= -->
        <!-- FIT TO LARGEST -->
        <!-- ========================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Fit to largest"
            android:textColor="@color/pdf_studio_secondary_gray"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!-- Largest Width -->

        <LinearLayout
            android:id="@+id/rowFitLargestWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_merge_page_size_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_sm">

            <RadioButton
                android:id="@+id/radioFitLargestWidth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:buttonTint="@color/rgb_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_fit_largest_width_label"
                    android:textColor="@color/pdf_studio_dark_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_fit_largest_width_desc"
                    android:textColor="@color/pdf_studio_secondary_gray"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Largest Height -->

        <LinearLayout
            android:id="@+id/rowFitLargestHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_merge_page_size_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_sm">

            <RadioButton
                android:id="@+id/radioFitLargestHeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:buttonTint="@color/rgb_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_fit_largest_height_label"
                    android:textColor="@color/pdf_studio_dark_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_fit_largest_height_desc"
                    android:textColor="@color/pdf_studio_secondary_gray"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Largest Both -->

        <LinearLayout
            android:id="@+id/rowFitLargestBoth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_merge_page_size_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_sm">

            <RadioButton
                android:id="@+id/radioFitLargestBoth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:buttonTint="@color/rgb_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_fit_largest_label"
                    android:textColor="@color/pdf_studio_dark_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_fit_largest_desc"
                    android:textColor="@color/pdf_studio_secondary_gray"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================= -->
        <!-- STANDARD PAGE SIZES -->
        <!-- ========================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Standard page size"
            android:textColor="@color/pdf_studio_secondary_gray"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!-- A4 -->

        <LinearLayout
            android:id="@+id/rowA4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_merge_page_size_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_sm">

            <RadioButton
                android:id="@+id/radioA4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:buttonTint="@color/rgb_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_a4_label"
                    android:textColor="@color/pdf_studio_dark_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_a4_desc"
                    android:textColor="@color/pdf_studio_secondary_gray"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- A3 -->

        <LinearLayout
            android:id="@+id/rowA3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_merge_page_size_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_sm">

            <RadioButton
                android:id="@+id/radioA3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:buttonTint="@color/rgb_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_a3_label"
                    android:textColor="@color/pdf_studio_dark_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_size_a3_desc"
                    android:textColor="@color/pdf_studio_secondary_gray"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Letter -->

        <LinearLayout
            android:id="@+id/rowLetter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_merge_page_size_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_sm">

            <RadioButton
