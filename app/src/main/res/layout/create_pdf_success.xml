<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_home_page"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/backArrow"
            android:layout_width="@dimen/margin_30dp"
            android:layout_height="@dimen/margin_30dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Result"
            android:textSize="@dimen/margin_20dp"
            android:paddingStart="@dimen/margin_8dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            />



    </com.google.android.material.appbar.MaterialToolbar>


    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar_home_page"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Gradient header: icon + confetti -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/header_height"
                android:background="@drawable/bg_success_header_gradient">

                <!-- Confetti (purely decorative, no functional IDs) -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/shape_confetti_dot" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="40dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/shape_confetti_rect"
                    android:rotation="30" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="70dp"
                    android:layout_marginTop="60dp"
                    android:background="@drawable/shape_confetti_dot" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="70dp"
                    android:layout_marginTop="70dp"
                    android:background="@drawable/shape_confetti_rect"
                    android:rotation="-20" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="90dp"
                    android:background="@drawable/shape_confetti_rect" />

                <!-- Success icon -->
                <FrameLayout
                    android:layout_width="@dimen/status_circle_size"
                    android:layout_height="@dimen/status_circle_size"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_success_circle"
                    android:elevation="2dp">

                    <ImageView
                        android:id="@+id/successIcon"
                        android:layout_width="@dimen/status_icon_size"
                        android:layout_height="@dimen/status_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_success_icon"
                        android:src="@drawable/ic_check"
                        app:tint="@color/success_green" />
                </FrameLayout>
            </FrameLayout>

            <!-- Title / subtitle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg"
                android:paddingTop="@dimen/spacing_sm">

                <TextView
                    android:id="@+id/successTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/success_title"
                    android:textColor="@color/success_green"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/successSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:text="@string/success_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_subtitle" />
            </LinearLayout>

            <!-- Card + buttons (horizontal padding applied here) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_lg">

                <!-- PDF info card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/pdfInfoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="@dimen/card_stroke_width">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/spacing_md">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/pdfPreviewCard"
                            android:layout_width="@dimen/pdf_thumb_width"
                            android:layout_height="@dimen/pdf_thumb_height"
                            app:strokeColor="@color/grey"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="@dimen/margin_12dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent">



                        <!-- Thumbnail -->
                        <ImageView
                            android:id="@+id/pdfPreview"
                            android:layout_width="@dimen/pdf_thumb_width"
                            android:layout_height="@dimen/pdf_thumb_height"
                            android:background="@drawable/bg_pdf_thumb"
                            android:contentDescription="@string/cd_pdf_preview"
                            android:scaleType="centerInside"
                            android:src="@drawable/pdf_icon_1_cmp_pdf"
                            />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pdf_badge"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="@string/label_pdf_badge"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/pdfPreviewCard"
                            app:layout_constraintStart_toStartOf="@id/pdfPreviewCard"
                            android:layout_marginStart="-3dp"
                            />

                        <!-- File name -->
                        <TextView
                            android:id="@+id/pdfName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold"
                            tools:text="PDF_172391234.pdf"
                            app:layout_constraintTop_toTopOf="@id/pdfPreviewCard"
                            app:layout_constraintStart_toEndOf="@id/pdfPreviewCard"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Pages -->
                        <TextView
                            android:id="@+id/pdfPages"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:drawablePadding="@dimen/spacing_xs"
                            android:gravity="center_vertical"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_caption"
                            tools:text="8 Pages"
                            app:drawableStartCompat="@drawable/ic_pages"
                            app:drawableTint="@color/text_secondary"
                            app:layout_constraintTop_toBottomOf="@id/pdfName"
                            app:layout_constraintStart_toEndOf="@id/pdfPreviewCard"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Size -->
                        <TextView
                            android:id="@+id/pdfSize"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:drawablePadding="@dimen/spacing_xs"
                            android:gravity="center_vertical"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_caption"
                            tools:text="2.4 MB"
                            app:drawableStartCompat="@drawable/ic_storage"
                            app:drawableTint="@color/text_secondary"
                            app:layout_constraintTop_toBottomOf="@id/pdfPages"
                            app:layout_constraintStart_toEndOf="@id/pdfPreviewCard"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Date -->
                        <TextView
                            android:id="@+id/pdfDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:drawablePadding="@dimen/spacing_xs"
                            android:gravity="center_vertical"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_caption"
                            tools:text="20 May 2025, 10:30 AM"
                            app:drawableStartCompat="@drawable/ic_calendar"
                            app:drawableTint="@color/text_secondary"
                            app:layout_constraintTop_toBottomOf="@id/pdfSize"
                            app:layout_constraintStart_toEndOf="@id/pdfPreviewCard"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Primary action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openPdf"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:backgroundTint="@color/pdf_red"
                    android:text="@string/action_open_pdf"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/margin_15dp"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/button_corner_radius"
                    app:icon="@drawable/ic_open"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/downloadPdf"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:backgroundTint="@color/pdf_red"
                    android:text="Download PDF"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/margin_15dp"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/button_corner_radius"
                    app:icon="@drawable/download_icon"
                    app:iconSize="@dimen/margin_30dp"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />

                <!-- Secondary actions row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton

                        android:id="@+id/sharePdf"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/action_share_pdf"
                        android:textAllCaps="false"
                        android:textColor="@color/pdf_red"
                        app:cornerRadius="@dimen/button_corner_radius"
                        app:icon="@drawable/ic_share"
                        app:iconGravity="textStart"
                        app:iconTint="@color/pdf_red"
                        app:strokeColor="@color/pdf_red"

                        />

                    <com.google.android.material.button.MaterialButton

                        android:id="@+id/createAnotherPdf"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/action_create_another"
                        android:textAllCaps="false"
                        android:textColor="@color/pdf_red"
                        app:cornerRadius="@dimen/button_corner_radius"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconTint="@color/pdf_red"
                        app:strokeColor="@color/pdf_red"
                        />


                </LinearLayout>

                <!-- Done (tertiary, text-style) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/done"
                    android:layout_gravity="center"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/margin_20dp"
                    android:text="@string/action_done"
                    android:textSize="@dimen/margin_18dp"
                    android:textAllCaps="false"
                    android:textColor="@color/pdf_red"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
