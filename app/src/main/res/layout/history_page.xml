<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">


    <!-- ================================================= -->
    <!-- TOOLBAR                                           -->
    <!-- ================================================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_home_page"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bluish_color"
        android:paddingStart="@dimen/margin_22dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- TOOLBAR TITLE -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"

            android:layout_gravity="center_vertical"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"

                android:scaleType="centerInside"
                android:src="@drawable/pdf_history_ic"

                android:contentDescription="@null" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="10dp"

                android:text="PDF History"

                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="normal" />

        </LinearLayout>


        <!-- THREE DOT MENU -->

        <ImageView
            android:id="@+id/historyMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:padding="@dimen/margin_10dp"
            android:src="@drawable/three_dot_vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="More options"
            app:tint="@color/white" />

    </com.google.android.material.appbar.MaterialToolbar>


    <LinearLayout

        android:id="@+id/history_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_history_container"
        app:layout_constraintTop_toBottomOf="@id/toolbar_home_page"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">




        <LinearLayout
            android:id="@+id/layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="18dp"
            android:gravity="end"
            android:orientation="horizontal">



        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_recent_files"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="18dp"
            android:overScrollMode="never"
            android:scrollbars="none" />

    </LinearLayout>



    <LinearLayout
        android:id="@+id/no_recentFileImg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:visibility="gone"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_home_page"
        app:layout_constraintBottom_toBottomOf="parent">

    <ImageView

        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:adjustViewBounds="true"
        android:scaleType="centerInside"
        android:src="@drawable/no_pdf"
        android:contentDescription="@null"
        android:layout_marginBottom="@dimen/margin_24dp"
        />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_recent_pdfs"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="@dimen/margin_20dp"
            tools:ignore="SpUsage" />



    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>