<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_header_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_drawer_header_gradient"
    android:paddingStart="@dimen/drawer_padding_horizontal"
    android:paddingEnd="@dimen/drawer_padding_horizontal"
    android:paddingTop="@dimen/drawer_header_padding_vertical"
    android:paddingBottom="20dp">

    <!-- Circular avatar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_avatar_container"
        android:layout_width="@dimen/drawer_avatar_size"
        android:layout_height="@dimen/drawer_avatar_size"
        app:cardCornerRadius="@dimen/drawer_avatar_corner_radius"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/drawer_surface"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/iv_profile_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="18dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_person"
            app:tint="@color/pdf_primary"
            android:contentDescription="@string/drawer_cd_profile_avatar" />

    </com.google.android.material.card.MaterialCardView>

    <!-- User name -->
    <TextView
        android:id="@+id/tv_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/drawer_default_user_name"
        android:textColor="@color/drawer_header_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/cv_avatar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- User email -->
    <TextView
        android:id="@+id/tv_user_email"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/drawer_default_user_email"
        android:textColor="@color/drawer_header_text_secondary"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/tv_user_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
