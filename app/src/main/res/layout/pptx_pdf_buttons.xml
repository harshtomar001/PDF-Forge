<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/upload_Layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/dashed_border_1"
    android:paddingTop="@dimen/margin_10dp"
    android:paddingStart="@dimen/margin_8dp"
    android:paddingEnd="@dimen/margin_8dp"
    android:paddingBottom="@dimen/margin_10dp"
    android:clickable="true"
    android:focusable="true"
    android:visibility="visible"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

        <ImageView
            android:id="@+id/ppt_image"
            android:layout_width="@dimen/margin_40dp"
            android:layout_height="@dimen/margin_40dp"
            android:src="@drawable/ppt_icon"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:duplicateParentState="true"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:layout_marginLeft="@dimen/margin_5dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/upl_ppt_title"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Upload PPT"
                android:textSize="15dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#E8531A"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/upl_ppt_text"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Upload pptx to convert to PDF"
                android:textSize="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/grey"/>

        </LinearLayout>

    </LinearLayout>
