<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

<!-- Toolbar -->

<LinearLayout
    android:id="@+id/topBar"
    android:layout_width="0dp"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:layout_marginTop="@dimen/margin_12dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <ImageButton
        android:id="@+id/backBtnCropLayout"
        android:layout_width="@dimen/margin_30dp"
        android:layout_height="@dimen/margin_30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back_arrow"
        android:tint="#000000"
        tools:ignore="UseAppTint" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="Crop Page"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#000000"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/resetBtnCropLayout"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:visibility="gone"
        android:text="Reset"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#2563EB"
        app:icon="@drawable/refresh"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconTint="#2563EB"

        app:backgroundTint="@android:color/transparent"
        app:rippleColor="#332563EB"
        app:strokeWidth="0dp"
        app:elevation="0dp"

        android:minWidth="0dp"
        android:minHeight="40dp"
        android:paddingHorizontal="8dp"/>

</LinearLayout>

    <View
        android:id="@+id/titleBreak"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="0.4"
        android:layout_marginHorizontal="@dimen/margin_8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        android:background="@color/darkGray"
        />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cropInfoCard"
        android:layout_width="wrap_content"
        android:layout_height="40dp"

        android:layout_marginTop="12dp"

        app:cardBackgroundColor="#F5F5F5"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="#DDDDDD"

        app:layout_constraintTop_toBottomOf="@id/titleBreak"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/cropInfoText"

            android:layout_width="wrap_content"
            android:layout_height="match_parent"

            android:gravity="center"

            android:paddingStart="18dp"
            android:paddingEnd="18dp"

            android:text="1280 × 1750 px"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#212121"/>

    </com.google.android.material.card.MaterialCardView>

<!-- Crop Container -->

<FrameLayout
    android:id="@+id/cropContainer"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_margin="16dp"
    android:background="@drawable/crop_bg"
    android:padding="8dp"
    app:layout_constraintTop_toBottomOf="@id/cropInfoCard"
    app:layout_constraintBottom_toTopOf="@id/applyBtnCropLayout"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <com.harsh.pdfstudio.custom_view.CropImageView
        android:id="@+id/cropImageView"
        android:layout_width="match_parent"

        android:layout_height="match_parent"/>

</FrameLayout>

<!-- Apply Button -->

<com.google.android.material.button.MaterialButton
    android:id="@+id/applyBtnCropLayout"
    android:layout_width="0dp"
    android:layout_height="52dp"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="20dp"
    android:text="Apply Crop"
    android:textAllCaps="false"
    android:textStyle="bold"
    android:textColor="#FFFFFF"
    app:cornerRadius="@dimen/margin_16dp"
    app:backgroundTint="#2563EB"
    android:backgroundTint="@null"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>