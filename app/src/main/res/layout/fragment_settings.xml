<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_screen_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/settings_horizontal_margin"
            android:paddingEnd="@dimen/settings_horizontal_margin"
            android:paddingTop="24dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/settings_text_primary"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_subtitle"
                android:textSize="14sp"
                android:textColor="@color/settings_text_secondary"
                android:includeFontPadding="false" />

        </LinearLayout>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/SettingsCard">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/settings_card_padding">


                <TextView
                    style="@style/SettingsSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_appearance" />

                <include
                    android:id="@+id/rowTheme"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_setting_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_divider_height"
                    android:layout_marginStart="@dimen/settings_divider_inset" />

                <include
                    android:id="@+id/rowAccentColor"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/settings_card_padding">

                <TextView
                    style="@style/SettingsSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_pdf_settings" />

                <include
                    android:id="@+id/rowPageSize"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_setting_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_divider_height"
                    android:layout_marginStart="@dimen/settings_divider_inset" />

                <include
                    android:id="@+id/rowPageMargin"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_setting_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_divider_height"
                    android:layout_marginStart="@dimen/settings_divider_inset" />

                <include
                    android:id="@+id/rowRememberLastSettings"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/settings_card_padding">

                <TextView
                    style="@style/SettingsSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_storage" />

                <include
                    android:id="@+id/rowAppStorage"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_setting_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_divider_height"
                    android:layout_marginStart="@dimen/settings_divider_inset" />

                <include
                    android:id="@+id/rowAutoCleanup"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_setting_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_divider_height"
                    android:layout_marginStart="@dimen/settings_divider_inset" />

                <include
                    android:id="@+id/rowCleanupAfter"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/settings_card_padding">

                <TextView
                    style="@style/SettingsSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_notifications" />

                <include
                    android:id="@+id/rowPdfCompletionNotif"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_setting_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_divider_height"
                    android:layout_marginStart="@dimen/settings_divider_inset" />

                <include
                    android:id="@+id/rowErrorNotif"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_setting_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_divider_height"
                    android:layout_marginStart="@dimen/settings_divider_inset" />

                <include
                    android:id="@+id/rowNotificationSound"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/settings_card_padding">

                <TextView
                    style="@style/SettingsSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_pdf_operations" />

                <include
                    android:id="@+id/rowOpenAfterCreation"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_setting_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_divider_height"
                    android:layout_marginStart="@dimen/settings_divider_inset" />

                <include
                    android:id="@+id/rowSaveGeneratedPdfs"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_setting_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_divider_height"
                    android:layout_marginStart="@dimen/settings_divider_inset" />

                <include
                    android:id="@+id/rowAskBeforeOverwrite"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/settings_card_padding">

                <TextView
                    style="@style/SettingsSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_about" />

                <include
                    android:id="@+id/rowAboutApp"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_setting_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_divider_height"
                    android:layout_marginStart="@dimen/settings_divider_inset" />

                <include
                    android:id="@+id/rowHelpSupport"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_setting_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_divider_height"
                    android:layout_marginStart="@dimen/settings_divider_inset" />

                <include
                    android:id="@+id/rowTerms"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_setting_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_divider_height"
                    android:layout_marginStart="@dimen/settings_divider_inset" />

                <include
                    android:id="@+id/rowPrivacyPolicy"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/item_setting_divider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_divider_height"
                    android:layout_marginStart="@dimen/settings_divider_inset" />

                <include
                    android:id="@+id/rowAppVersion"
                    layout="@layout/item_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <LinearLayout
            android:id="@+id/resetSettingsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginBottom="6dp"
                android:src="@drawable/ic_restore"
                app:tint="@color/settings_error"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_settings_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/settings_error" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/reset_settings_subtitle"
                android:textSize="12sp"
                android:textColor="@color/settings_text_secondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

