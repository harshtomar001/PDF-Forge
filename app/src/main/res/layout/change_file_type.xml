<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chnge_file_type_gradient_pdf"
    >

    <LinearLayout
        android:id="@+id/title_layout_for_file_type"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:background="#4B90EB"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
    >


    <ImageView
        android:id="@+id/back_arrow_forfiletype"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:src="@drawable/ic_back_arrow"
        android:clickable="true"
        />


    <TextView
        android:id="@+id/change_file_type_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/file_converter"
        android:textColor="@color/white"
        android:layout_marginRight="@dimen/margin_60dp"
        android:layout_weight="1"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingBottom="15dp"
        android:paddingTop="@dimen/margin_30dp"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="34sp"

    />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/layout_upl_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/title_layout_for_file_type"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        >



        <com.google.android.material.button.MaterialButton
            android:id="@+id/upload_files"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_12dp"
            android:layout_marginBottom="4dp"
            android:text="@string/upload_file"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:icon="@drawable/upload_sign"
            app:iconTint="@color/white"
            app:iconPadding="8dp"
            app:iconSize="32dp"
            android:background="@drawable/btn_blue_gradient"
            app:backgroundTint="@null"
            />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/convert_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginBottom="4dp"
            android:text="@string/convert"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/btn_blue_gradient"
            app:backgroundTint="@null"
            android:layout_marginTop="@dimen/margin_12dp"
            android:layout_marginLeft="8dp"

            />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:id="@+id/frame_layout_radio"
        android:visibility="gone"

        >

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="350dp"
            android:orientation="vertical"
            android:background="@drawable/border_radius"
            android:layout_gravity="center"
            android:elevation="@dimen/margin_22dp"

            >


            <TextView
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_22dp"
                android:text="@string/choose_output_format"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="@dimen/margin_22dp"
                android:textStyle="bold"/>

            <RadioGroup

                android:id="@+id/radio_group_change_file_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="7dp"
                android:layout_marginRight="7dp"

                >


                <RadioButton
                    android:id="@+id/pdf_radioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pdf"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="20sp"

                    />


                <RadioButton
                    android:id="@+id/pptx_radioButton3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:text="@string/pptx"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    />


                <RadioButton
                    android:id="@+id/docx_radioButton5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:text="@string/docx"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    />

            </RadioGroup>



            <com.google.android.material.button.MaterialButton
                android:id="@+id/gen_file_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/generate"
                android:background="@drawable/btn_blue_gradient"
                app:backgroundTint="@null"
                android:layout_marginTop="@dimen/margin_12dp"
                android:layout_gravity="center_horizontal"/>

        </LinearLayout>

    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview_for_change_file_type"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        app:layout_constraintTop_toBottomOf="@id/layout_upl_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:scrollbarThumbVertical="@drawable/scrollvar_color"



         />


</androidx.constraintlayout.widget.ConstraintLayout>