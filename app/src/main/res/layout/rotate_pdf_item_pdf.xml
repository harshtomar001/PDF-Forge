<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:id="@+id/pdf_preview"
    android:visibility="visible"
    android:layout_margin="16dp"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toBottomOf="@id/toolbar_rot_btns"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp"
    app:cardCornerRadius="12dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/pdf_icon_cmp_pdf_preview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="pdf icon"
            android:layout_marginTop="@dimen/margin_5dp"
            app:srcCompat="@drawable/pdf_icon_adjusted"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>



        <LinearLayout
            android:id="@+id/text_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/pdf_icon_cmp_pdf_preview"
            app:layout_constraintEnd_toStartOf="@id/change_pdf"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">


            <TextView
                android:id="@+id/PDFName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="hello.pdf"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end"/>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:alpha="0.7">

                <TextView
                    android:id="@+id/PDFPages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 Pages"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/black"
                    android:textSize="12sp"/>

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/fullstop"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/PDFSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.45 MB"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/black"
                    android:textSize="12sp"/>
            </LinearLayout>

        </LinearLayout>



        <TextView
            android:id="@+id/change_pdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_bg_rotp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/change"
            android:textColor="#4A1F8C"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>