<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="true">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingTop="@dimen/export_sheet_top_padding"
        android:paddingBottom="@dimen/export_sheet_bottom_padding">



        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintWidth_max="@dimen/export_sheet_max_width"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/margin_25dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/back_arrow_export_page"
                android:layout_width="@dimen/margin_30dp"
                android:layout_height="@dimen/margin_30dp"
                android:src="@drawable/ic_back_arrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_title"
                app:layout_constraintHorizontal_bias="0"
                android:layout_marginStart="@dimen/margin_12dp"
                app:tint="@color/black"

                tools:ignore="MissingConstraints" />


            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-black"
                android:text="Export Page"
                android:textColor="@color/export_title"
                android:textSize="@dimen/margin_20dp"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/margin_12dp"
                app:layout_constraintStart_toEndOf="@+id/back_arrow_export_page"

                tools:ignore="MissingConstraints" />


            <View
                android:id="@+id/divider_title"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/black"
                android:alpha="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="@dimen/margin_8dp"
                android:layout_marginEnd="@dimen/margin_8dp"
                android:layout_marginBottom="@dimen/margin_8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_title" />



            <TextView
                android:id="@+id/tv_filename_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/export_sheet_side_margin"
                android:layout_marginEnd="@dimen/export_sheet_side_margin"
                android:layout_marginTop="22dp"
                android:text="File name"
                android:textColor="@color/export_title"
                android:textSize="@dimen/export_label_size"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider_title" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/filename_field"
                android:layout_width="0dp"
                android:layout_height="@dimen/export_input_height"
                android:layout_marginStart="@dimen/export_sheet_side_margin"
                android:layout_marginEnd="@dimen/export_sheet_side_margin"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_filename_input"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_filename_label">

                <ImageView
                    android:id="@+id/iv_filename_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/pdf_fevicon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/edit_fileName"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:inputType="text"
                    android:maxLines="1"
                    android:text="Page_5"
                    android:textColor="@color/export_title"
                    android:textSize="@dimen/export_input_text_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_extension_exp_pdf"
                    app:layout_constraintStart_toEndOf="@id/iv_filename_icon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_extension_exp_pdf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:text=".pdf"
                    android:textColor="@color/export_input_hint"
                    android:textSize="@dimen/export_input_text_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>



            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="@dimen/margin_20dp"
                android:text="@string/choose_the_format_you_want_to_export_this_page_as"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/export_subtitle"
                android:textSize="@dimen/export_subtitle_size"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/filename_field" />



            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/option_pdf"
                android:layout_width="0dp"
                android:layout_height="@dimen/export_option_card_height"
                android:layout_marginStart="@dimen/export_sheet_side_margin"
                android:layout_marginEnd="@dimen/export_sheet_side_margin"
                android:layout_marginTop="20dp"
                android:background="@drawable/selector_option_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="@dimen/export_option_card_padding"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

                <FrameLayout
                    android:id="@+id/icon_card_pdf"
                    android:layout_width="@dimen/export_icon_card_size"
                    android:layout_height="@dimen/export_icon_card_size"
                    android:background="@drawable/bg_icon_card"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="@dimen/export_icon_size"
                        android:layout_height="@dimen/export_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/pdf_fevicon" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_pdf_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:text="PDF (.pdf)"
                    android:textColor="@color/export_title"
                    android:textSize="@dimen/export_option_title_size"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/radio_pdf"
                    app:layout_constraintStart_toEndOf="@id/icon_card_pdf"
                    app:layout_constraintTop_toTopOf="@id/icon_card_pdf" />

                <TextView
                    android:id="@+id/tv_pdf_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/best_for_documents_and_maintains_original_quality"
                    android:textColor="@color/export_subtitle"
                    android:textSize="@dimen/export_option_desc_size"
                    app:layout_constraintEnd_toStartOf="@id/radio_pdf"
                    app:layout_constraintStart_toStartOf="@id/tv_pdf_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_pdf_title" />

                <FrameLayout
                    android:id="@+id/radio_pdf"
                    android:layout_width="@dimen/export_radio_size"
                    android:layout_height="@dimen/export_radio_size"
                    android:background="@drawable/radio_selected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">



                </FrameLayout>



            </androidx.constraintlayout.widget.ConstraintLayout>



            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/option_png"
                android:layout_width="0dp"
                android:layout_height="@dimen/export_option_card_height"
                android:layout_marginStart="@dimen/export_sheet_side_margin"
                android:layout_marginEnd="@dimen/export_sheet_side_margin"
                android:layout_marginTop="@dimen/export_option_card_spacing"
                android:background="@drawable/selector_option_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="@dimen/export_option_card_padding"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/option_pdf">

                <FrameLayout
                    android:id="@+id/icon_card_png"
                    android:layout_width="@dimen/export_icon_card_size"
                    android:layout_height="@dimen/export_icon_card_size"
                    android:background="@drawable/bg_icon_card_png"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="@dimen/export_icon_size"
                        android:layout_height="@dimen/export_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_format_image" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_png_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:text="PNG Image (.png)"
                    android:textColor="@color/export_title"
                    android:textSize="@dimen/export_option_title_size"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/radio_png"
                    app:layout_constraintStart_toEndOf="@id/icon_card_png"
                    app:layout_constraintTop_toTopOf="@id/icon_card_png" />

                <TextView
                    android:id="@+id/tv_png_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="High quality image with lossless compression."
                    android:textColor="@color/export_subtitle"
                    android:textSize="@dimen/export_option_desc_size"
                    app:layout_constraintEnd_toStartOf="@id/radio_png"
                    app:layout_constraintStart_toStartOf="@id/tv_png_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_png_title" />

                <FrameLayout
                    android:id="@+id/radio_png"
                    android:layout_width="@dimen/export_radio_size"
                    android:layout_height="@dimen/export_radio_size"
                    android:background="@drawable/selector_radio_bg"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" >





                </FrameLayout>



            </androidx.constraintlayout.widget.ConstraintLayout>



            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/option_jpeg"
                android:layout_width="0dp"
                android:layout_height="@dimen/export_option_card_height"
                android:layout_marginStart="@dimen/export_sheet_side_margin"
                android:layout_marginEnd="@dimen/export_sheet_side_margin"
                android:layout_marginTop="@dimen/export_option_card_spacing"
                android:background="@drawable/selector_option_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="@dimen/export_option_card_padding"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/option_png">

                <FrameLayout
                    android:id="@+id/icon_card_jpeg"
                    android:layout_width="@dimen/export_icon_card_size"
                    android:layout_height="@dimen/export_icon_card_size"
                    android:background="@drawable/bg_icon_card_jpeg"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="@dimen/export_icon_size"
                        android:layout_height="@dimen/export_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_format_image" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_jpeg_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:text="JPEG Image (.jpg)"
                    android:textColor="@color/export_title"
                    android:textSize="@dimen/export_option_title_size"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/radio_jpeg"
                    app:layout_constraintStart_toEndOf="@id/icon_card_jpeg"
                    app:layout_constraintTop_toTopOf="@id/icon_card_jpeg" />

                <TextView
                    android:id="@+id/tv_jpeg_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Smaller file size with good quality."
                    android:textColor="@color/export_subtitle"
                    android:textSize="@dimen/export_option_desc_size"
                    app:layout_constraintEnd_toStartOf="@id/radio_jpeg"
                    app:layout_constraintStart_toStartOf="@id/tv_jpeg_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_jpeg_title" />

                <FrameLayout
                    android:id="@+id/radio_jpeg"
                    android:layout_width="@dimen/export_radio_size"
                    android:layout_height="@dimen/export_radio_size"
                    android:background="@drawable/selector_radio_bg"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />





            </androidx.constraintlayout.widget.ConstraintLayout>






            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_share_after_export"
                android:layout_width="@dimen/export_checkbox_size"
                android:layout_height="@dimen/export_checkbox_size"
                android:button="@drawable/selector_checkbox"
                android:layout_marginStart="@dimen/export_sheet_side_margin"
                android:layout_marginTop="@dimen/margin_18dp"
                android:buttonTint="@null"
                app:buttonTint="@null"
                android:text=""
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:checked="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/option_jpeg" />


            <TextView
                android:id="@+id/tv_share_after_export"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="@dimen/export_sheet_side_margin"
                android:text="Share after export"
                android:textColor="@color/export_title"
                android:textSize="@dimen/export_share_text_size"
                app:layout_constraintBottom_toBottomOf="@id/cb_share_after_export"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cb_share_after_export"
                app:layout_constraintTop_toTopOf="@id/cb_share_after_export" />



            <View
                android:id="@+id/divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="@dimen/margin_8dp"
                android:layout_marginStart="@dimen/margin_8dp"
                android:background="@color/export_divider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cb_share_after_export" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_export_page"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="@dimen/export_sheet_side_margin"
                android:layout_marginTop="@dimen/margin_25dp"
                android:text="@string/export_page"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="@dimen/margin_18dp"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/blue_color"
                app:cornerRadius="12dp"
                app:icon="@drawable/upload_sign"
                android:paddingTop="@dimen/margin_12dp"
                android:paddingBottom="@dimen/margin_12dp"
                app:iconPadding="9dp"
                app:iconSize="@dimen/margin_25dp"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>



</ScrollView>