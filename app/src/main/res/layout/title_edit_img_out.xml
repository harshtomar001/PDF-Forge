<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/title_edit_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#3D7BEF"
    android:paddingLeft="@dimen/margin_8dp"
    android:paddingRight="@dimen/margin_8dp"
    android:paddingTop= "@dimen/margin_22dp"
    android:orientation="horizontal"
    android:textAlignment="center">

    <ImageView
        android:id="@+id/back_arrow_edit_image"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:clickable="true"
        android:layout_gravity="center_vertical"
        android:contentDescription="@string/todo"
        android:focusable="true"
        android:padding="10dp"
        app:srcCompat="@drawable/ic_back_arrow"
        />

    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_marginLeft="@dimen/margin_5dp"
        >

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conversion_complete"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:textSize="17sp"
            android:textStyle="bold"
            />


        <TextView
            android:id="@+id/n_images_converted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 images completed successfully"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:textSize="10sp"
            android:alpha="0.8"
            />

    </LinearLayout>
    <View
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="0dp"/>

    <ImageView
        android:layout_width="@dimen/margin_50dp"
        android:layout_height="@dimen/margin_50dp"
        android:src="@drawable/green_tick_circle"
        android:layout_gravity="center_vertical"
        />

</LinearLayout>