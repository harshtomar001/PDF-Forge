<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/edit_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_2">

    <include
        android:id="@+id/toolbar_edit_page_pdf"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        layout="@layout/edit_pdf_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        />

    <include
        android:id="@+id/main_tools_layout"
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        layout="@layout/edit_pdf_edit_pg_btns_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias=".5"
        android:layout_marginVertical="@dimen/margin_15dp"
        android:layout_marginHorizontal="@dimen/margin_18dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_edit_page_pdf"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_edit_pg_img_view"
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:cardCornerRadius="@dimen/margin_12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/secondary_btns"
        app:layout_constraintTop_toBottomOf="@id/main_tools_layout"
        android:layout_marginTop="@dimen/margin_12dp"
        android:layout_marginBottom="@dimen/margin_15dp"
        android:layout_marginHorizontal="@dimen/margin_18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <com.github.chrisbanes.photoview.PhotoView
            android:id="@+id/edit_page_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:src="@drawable/loading_img"
            />


            <LinearLayout
                android:id="@+id/page_control_layout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#f0f0f0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageButton
                    android:id="@+id/btn_prev_page"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/arrow_left"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                <TextView
                    android:id="@+id/page_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:text="1 / 1"
                    android:textSize="16dp"
                    android:textStyle="bold"/>

                <ImageButton
                    android:id="@+id/btn_next_page"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/arrow_right"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

            </LinearLayout>

        </LinearLayout>


    </androidx.cardview.widget.CardView>

    <include
        android:id="@+id/secondary_btns"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        layout="@layout/edit_pdf_edit_pg_btns_2"
        android:layout_marginVertical="@dimen/margin_15dp"
        android:layout_marginHorizontal="@dimen/margin_18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        />

    <FrameLayout
        android:id="@+id/more_tools_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/more_tools_click_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="80dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:background="@drawable/edt_pdf_pg_tool_bg"
            android:elevation="12dp"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/extract_page"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/extract_page"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Export Page"
                    android:textColor="@color/darkGray"
                    android:textSize="16dp"/>
            </LinearLayout>



            <LinearLayout
                android:id="@+id/rotate_left"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/rotate_page_left"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Rotate Left"
                    android:textColor="@color/darkGray"
                    android:textSize="16dp"/>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/rotate_right"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/rotate_page_right"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Rotate Right"
                    android:textColor="@color/darkGray"
                    android:textSize="16dp"/>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/replace_page"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/replace_page"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Replace Page"
                    android:textColor="@color/darkGray"
                    android:textSize="16dp"/>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>





</androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/watermark_overlay"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        layout="@layout/edit_pdf_watermark"
        android:visibility="gone"
        />

    <include
        layout="@layout/save_discard_layout"
        android:id="@+id/save_discard_Overlay"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:visibility="gone"
        />

    <include
        layout="@layout/edit_pdf_crop_page_layout"
        android:id="@+id/cropOverlay"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:visibility="gone"
        />

    <include
        layout="@layout/edit_pdf_export_page"
        android:id="@+id/exportOverlay"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:visibility="gone"
        />

    <include
        android:id="@+id/loading_overlay"
        layout="@layout/loading_bar"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:visibility="gone"

        />

    <include
        android:id="@+id/addImageOverlay"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        layout="@layout/edit_pdf_add_image"
        android:visibility="gone"
        />

    <include
        android:id="@+id/addTextOverlay"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        layout="@layout/edit_pdf_add_text"
        android:visibility="gone"

        />

    <com.harsh.pdfstudio.custom_view.ColorPickerView
        android:id="@+id/colorPicker"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:visibility="gone"

        />

    <include
        android:id="@+id/eraserOverLay"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        layout="@layout/edit_pdf_eraser"
        android:visibility="gone"
        />


</FrameLayout>