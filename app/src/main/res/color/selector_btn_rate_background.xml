<?xml version="1.0" encoding="utf-8"?>
<!--
    Background tint for btn_rate (MaterialButton), applied via app:backgroundTint.
    Disabled state (before a star is tapped) uses a muted tone of the primary
    color instead of full-strength blue, and full primary once enabled.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/rate_disabled_button" android:state_enabled="false" />
    <item android:color="@color/rate_primary" android:state_pressed="true" />
    <item android:color="@color/rate_primary" />
</selector>
