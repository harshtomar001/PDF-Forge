<?xml version="1.0" encoding="utf-8"?>
<!-- White rounded card with a very subtle light-blue outline, so the
     premium card reads as a first-class app feature, not an ad banner. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/pdf_studio_white" />
    <corners android:radius="@dimen/profile_card_corner_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/pdf_studio_light_blue" />
</shape>
