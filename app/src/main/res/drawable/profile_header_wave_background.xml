        android:pathData="M0,260 C90,290 270,230 360,270 L360,320 L0,320 Z"
        android:fillColor="@color/pdf_studio_blue_wave_light"
        android:fillAlpha="0.18" />

    <!-- Front wave, slightly darker, low opacity -->
    <path
        android:pathData="M0,285 C120,255 240,315 360,280 L360,320 L0,320 Z"
        android:fillColor="@color/pdf_studio_blue_wave_dark"
        android:fillAlpha="0.35" />

</vector>
