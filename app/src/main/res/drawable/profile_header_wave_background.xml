    <!-- Base fill -->
    <path
        android:pathData="M0,0 L360,0 L360,320 L0,320 Z"
        android:fillColor="@color/pdf_studio_primary_blue_dark" />

    <!-- Back wave, slightly lighter, low opacity -->
