<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">


    <style name="Base.Theme.PDF_Formatter"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- App surfaces -->
        <item name="android:windowBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>

        <!-- Primary BLUE -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorOnPrimaryContainer">@color/color_on_primary_container</item>

        <!-- Secondary blue -->
        <item name="colorSecondary">@color/color_secondary</item>

        <!-- Text -->
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/color_text_secondary</item>

        <!-- Borders / dividers -->
        <item name="colorOutline">@color/color_border</item>
        <item name="colorOutlineVariant">@color/color_divider</item>

        <!-- Error -->
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_on_error</item>

    </style>


    <!-- ========================================================= -->
    <!-- MAIN APPLICATION THEME                                    -->
    <!-- ========================================================= -->

    <style name="Theme.PDF_Formatter"
        parent="Base.Theme.PDF_Formatter" />


    <style name="Theme.MainActivity"
        parent="Base.Theme.PDF_Formatter">

        <item name="android:windowDisablePreview">true</item>

    </style>


    <style name="Theme.EditPDF"
        parent="Base.Theme.PDF_Formatter">

        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>

    </style>


    <style name="Theme.Splash"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.PDF_Formatter</item>

    </style>


    <style name="Widget.PdfStudio.Button.Primary"
        parent="Widget.Material3.Button">

        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/color_on_primary</item>

        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>

    </style>


    <style name="Widget.PdfStudio.Button.Outlined"
        parent="Widget.Material3.Button.OutlinedButton">

        <item name="strokeColor">@color/color_blue_border</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="iconTint">@color/color_primary</item>

        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>

    </style>


    <!-- ========================================================= -->
    <!-- BILLING CARD                                              -->
    <!-- ========================================================= -->

    <style name="Widget.PdfStudio.Card"
        parent="Widget.Material3.CardView.Outlined">

        <item name="cardCornerRadius">14dp</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/color_surface</item>

    </style>


    <!-- ========================================================= -->
    <!-- BILLING TEXT STYLES                                       -->
    <!-- ========================================================= -->

    <style name="TextAppearance.PdfStudio.SectionTitle"
        parent="TextAppearance.Material3.LabelMedium">

        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>

    </style>


    <style name="TextAppearance.PdfStudio.Title"
        parent="TextAppearance.Material3.TitleLarge">

        <item name="android:textColor">@color/color_text_primary</item>

    </style>


    <style name="TextAppearance.PdfStudio.Body"
        parent="TextAppearance.Material3.BodyMedium">

        <item name="android:textColor">@color/color_text_primary</item>

    </style>


    <style name="TextAppearance.PdfStudio.Caption"
        parent="TextAppearance.Material3.BodySmall">

        <item name="android:textColor">@color/color_text_secondary</item>

    </style>


    <!-- ========================================================= -->
    <!-- BILLING DIVIDER                                           -->
    <!-- ========================================================= -->

    <style name="Divider">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/color_divider</item>

    </style>

</resources>