<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BoldToolbarTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="title_text">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingTop">@dimen/margin_15dp</item>


    </style>

    <style name="NavItemTextStyle">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/inconsolata_condensed_bold</item>

    </style>

    <style name="color">

        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:statusBarColor">@color/statusBarColor</item>
    </style>


    <style name="RoundedCard">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>

    <style name="Theme.YourApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorControlActivated">@color/black</item>
    </style>

    <style name="PopupMenuStyle" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_bg</item>
        <item name="android:itemTextAppearance">@style/PopupMenuText</item>

        <item name="itemTextAppearance">@style/PopupMenuText</item>
    </style>

    <style name="PopupMenuText">

        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">15dp</item>
    </style>

    <style name="WatermarkPositionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_position_normal</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">12sp</item>
    </style>


        <style name="Widget.PdfStudio.TextInputLayout"
            parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <item name="boxCornerRadiusTopStart">@dimen/auth_corner_radius</item>
            <item name="boxCornerRadiusTopEnd">@dimen/auth_corner_radius</item>
            <item name="boxCornerRadiusBottomStart">@dimen/auth_corner_radius</item>
            <item name="boxCornerRadiusBottomEnd">@dimen/auth_corner_radius</item>

            <item name="boxStrokeColor">@color/text_input_stroke_selector</item>
            <item name="boxStrokeWidth">1dp</item>
            <item name="boxStrokeWidthFocused">2dp</item>

            <item name="hintTextColor">@color/colorTextSecondary</item>

            <item name="startIconTint">@color/colorPrimary</item>

            <item name="endIconTint">@color/colorTextSecondary</item>

            <item name="android:textColorHint">@color/colorTextSecondary</item>

        </style>

        <style name="Widget.PdfStudio.PrimaryButton"
            parent="Widget.MaterialComponents.Button">

            <item name="android:background">@drawable/bg_auth_button</item>
            <item name="backgroundTint">@null</item>

            <item name="android:textColor">@color/colorSurface</item>

            <item name="cornerRadius">@dimen/auth_corner_radius</item>

            <item name="android:minHeight">@dimen/auth_button_height</item>
            <item name="minHeight">@dimen/auth_button_height</item>

            <item name="android:elevation">2dp</item>
            <item name="elevation">2dp</item>

            <item name="android:paddingStart">18dp</item>
            <item name="android:paddingEnd">18dp</item>

        </style>

        <style name="Widget.PdfStudio.OutlinedButton"
            parent="Widget.MaterialComponents.Button.OutlinedButton">

            <item name="android:background">@drawable/bg_google_button</item>
            <item name="backgroundTint">@null</item>

            <item name="strokeColor">@color/colorBorder</item>
            <item name="strokeWidth">1dp</item>

            <item name="cornerRadius">@dimen/auth_corner_radius</item>

            <item name="android:minHeight">@dimen/auth_button_height</item>
            <item name="minHeight">@dimen/auth_button_height</item>

        </style>


    <style name="SummaryRowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/pdf_divider</item>
    </style>


    <style name="TextAppearance.AppStorage.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/storage_toolbar_title_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/storage_text_primary</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="ThemeOverlay.AppStorage.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>


    <style name="FilterChipStyle" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/chip_height</item>
        <item name="chipCornerRadius">@dimen/chip_corner_radius</item>
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="rippleColor">@color/blue_checkBox</item>
        <item name="android:textSize">13sp</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="ToolbarTitleAppearance" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="DrawerSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/drawer_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/drawer_padding_horizontal</item>
        <item name="android:paddingBottom">@dimen/drawer_section_label_spacing_bottom</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/pdf_primary</item>
    </style>

    <!-- One full clickable drawer row (icon + title/subtitle + chevron) -->
    <style name="DrawerItemRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/drawer_item_min_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/ripple_drawer_item</item>
        <item name="android:paddingStart">@dimen/drawer_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/drawer_padding_horizontal</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Circular tinted-icon container, 40dp -->
    <style name="DrawerItemIconContainer">
        <item name="android:layout_width">@dimen/drawer_icon_container_size</item>
        <item name="android:layout_height">@dimen/drawer_icon_container_size</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@drawable/bg_icon_circle</item>
    </style>

    <style name="DrawerItemIcon">
        <item name="android:layout_width">@dimen/drawer_icon_size</item>
        <item name="android:layout_height">@dimen/drawer_icon_size</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:tint">@color/pdf_primary</item>
    </style>

    <!-- Title + subtitle column, takes remaining width -->
    <style name="DrawerItemTextBlock">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="DrawerItemTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15.5sp</item>
        <item name="android:textColor">@color/drawer_text_primary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="DrawerItemSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/drawer_text_secondary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="DrawerItemChevron">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:tint">@color/drawer_text_secondary</item>
        <item name="android:alpha">0.7</item>
    </style>

    <!-- Thin divider between rows, indented to align under the item text -->
    <style name="DrawerDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">74dp</item>
        <item name="android:background">@color/drawer_divider</item>
    </style>

    <style name="RateStar">
        <item name="android:layout_width">@dimen/rate_star_touch_target</item>
        <item name="android:layout_height">@dimen/rate_star_touch_target</item>
        <item name="android:layout_marginStart">@dimen/rate_star_spacing</item>
        <item name="android:layout_marginEnd">@dimen/rate_star_spacing</item>
        <item name="android:padding">4dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">@drawable/ripple_circular</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:src">@drawable/ic_star_outline</item>
        <item name="android:tint">@color/rate_star_unselected</item>
    </style>


    <style name="RateBottomSheetDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/RateBottomSheetStyle</item>
    </style>

    <style name="RateBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="SettingsSectionTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/settings_section_title</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsCard" parent="Widget.Material3.CardView.Elevated">

        <item name="cardBackgroundColor">@color/settings_card_surface</item>

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="android:layout_marginStart">@dimen/settings_horizontal_margin</item>
        <item name="android:layout_marginEnd">@dimen/settings_horizontal_margin</item>
        <item name="android:layout_marginTop">12dp</item>

        <item name="cardCornerRadius">16dp</item>

    </style>


    <style name="SettingsRowTitle">
        <item name="android:textSize">@dimen/settings_title_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="SettingsRowDescription">
        <item name="android:textSize">@dimen/settings_description_size</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ThemeOverlay.PDFStudio.UpgradeToolbar" parent="ThemeOverlay.Material3.ActionBar">
        <item name="colorControlNormal">@color/white</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <style name="UpgradeToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>


    <style name="SectionLabel">
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="DetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/spacing_m</item>
        <item name="android:paddingEnd">@dimen/spacing_m</item>
        <item name="android:paddingTop">@dimen/spacing_m</item>
        <item name="android:paddingBottom">@dimen/spacing_m</item>
    </style>
    <style name="RowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">@dimen/spacing_m</item>
        <item name="android:layout_marginEnd">@dimen/spacing_m</item>
        <item name="android:background">@color/colorDivider</item>
    </style>
    <style name="BenefitRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">top</item>
    </style>
    <style name="BenefitIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:layout_marginEnd">@dimen/spacing_m</item>
        <item name="android:contentDescription">@null</item>
    </style>
    <style name="BenefitTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="BenefitDesc">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>




</resources>